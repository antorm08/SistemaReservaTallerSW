        bg: '#DCFCE7'
      },
      'futbol7': {
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M12 2c1.5 1 2.5 2 3 4l-3 3-3-3c.5-2 1.5-3 3-4z"/><path d="M2 12c1-1.5 2-2.5 4-3l3 3-3 3c-2-.5-3-1.5-4-3z"/><path d="M12 22c-1.5-1-2.5-2-3-4l3-3 3 3c-.5 2-1.5 3-3 4z"/><path d="M22 12c-1 1.5-2 2.5-4 3l-3-3 3-3c2 .5 3 1.5 4 3z"/></svg>',
