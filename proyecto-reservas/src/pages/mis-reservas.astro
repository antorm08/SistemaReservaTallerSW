---
// Página para ver mis reservas
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Mis Reservas">
  <Navbar />
  
  <div class="container">
    <div class="flex-between mb-2">
      <div>
        <h1 style="margin-bottom: 4px;">Mis Reservas</h1>
        <p style="color: var(--text-light); font-size: 14px;">Gestiona tus próximas actividades deportivas.</p>
      </div>
      <a href="/reservar" class="btn btn-primary">+ Nueva Reserva</a>
    </div>
    
    <!-- Stats Cards -->
    <div class="stats-grid mb-4">
      <div class="stat-card">
        <div class="stat-label">Total Reservas</div>
        <div class="stat-value" id="totalReservas">0</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Pendientes</div>
        <div class="stat-value" id="totalPendientes" style="color: #F59E0B;">0</div>
      </div>
      <div class="stat-card">
        <label class="stat-label" for="fechaFiltro">Filtrar por Fecha</label>
        <input type="date" id="fechaFiltro" class="form-input" style="margin-top: 8px;">
      </div>
      <div class="stat-card">
        <label class="stat-label" for="tipoFiltro">Tipo de Espacio</label>
        <select id="tipoFiltro" class="form-select" style="margin-top: 8px;">
          <option value="">Todos</option>
        </select>
      </div>
    </div>
    
    <div class="tabs">
      <button class="tab active" data-estado="todas">Todas</button>
      <button class="tab" data-estado="pendiente">Pendientes <span class="tab-badge" id="badgePendiente">0</span></button>
      <button class="tab" data-estado="proximas">Próximas</button>
      <button class="tab" data-estado="completada">Completadas</button>
      <button class="tab" data-estado="cancelada">Canceladas</button>
    </div>
    
    <div id="loading" class="text-center" style="padding: 40px;">
      <div class="loading" style="width: 40px; height: 40px;"></div>
      <p class="mt-2">Cargando reservas...</p>
    </div>
    
    <div id="reservasTable" style="display: none;">
      <div class="table-responsive">
        <table class="table">
          <thead>
            <tr>
              <th style="width: 60px;">ID</th>
              <th style="min-width: 220px;">ESPACIO</th>
              <th style="min-width: 150px;">FECHA & HORARIO</th>
              <th style="width: 120px;">ESTADO</th>
              <th style="width: 100px;">MONTO</th>
              <th style="width: 120px;">ACCIONES</th>
            </tr>
          </thead>
          <tbody id="reservasBody">
          </tbody>
        </table>
      </div>
      
      <!-- Paginación -->
      <div id="misReservasPagination" style="padding: 16px 24px; background: white; border-top: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; margin-top: 0;">
        <div style="font-size: 13px; color: var(--text-light);" id="misReservasPaginationInfo">
          Mostrando <span id="misReservasFrom">1</span> a <span id="misReservasTo">10</span> de <span id="misReservasTotal">0</span> reservas
        </div>
        <div style="display: flex; gap: 12px;" id="misReservasPaginationButtons">
          <button class="btn btn-sm" onclick="cambiarPaginaMisReservas('prev')" id="misReservasPrevBtn" style="padding: 8px 18px; font-size: 14px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 8px; font-weight: 600; box-shadow: 0 2px 8px rgba(16,185,129,0.08); transition: background 0.2s; display: flex; align-items: center; gap: 6px;" disabled>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align: middle;"><path d="M15 18l-6-6 6-6"></path></svg>
            Anterior
          </button>
          <button class="btn btn-sm" onclick="cambiarPaginaMisReservas('next')" id="misReservasNextBtn" style="padding: 8px 18px; font-size: 14px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 8px; font-weight: 600; box-shadow: 0 2px 8px rgba(16,185,129,0.08); transition: background 0.2s; display: flex; align-items: center; gap: 6px;" disabled>
            Siguiente
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align: middle;"><path d="M9 6l6 6-6 6"></path></svg>
          </button>
        </div>
      </div>
    </div>
    
    <div id="noReservas" style="display: none;" class="card text-center">
      <p style="color: var(--text-light);">No tienes reservas</p>
      <a href="/reservar" class="btn btn-primary mt-3">Hacer una Reserva</a>
    </div>
  </div>
  
  <!-- Modal para cancelar -->
  <div id="cancelModal" class="modal">
    <div class="modal-content">
      <h3 style="margin-bottom: 16px;">Cancelar Reserva</h3>
      <div id="cancelAlert"></div>
      <div class="form-group">
        <label class="form-label" for="motivoCancelacion">Motivo de cancelación (opcional)</label>
        <textarea class="form-textarea" id="motivoCancelacion" placeholder="Ej: Cambio de planes, mal tiempo, etc."></textarea>
      </div>
      <div class="flex gap-2" style="justify-content: flex-end;">
        <button class="btn btn-secondary" onclick="cerrarModal()">Cancelar</button>
        <button class="btn btn-danger" id="confirmarCancelar">Confirmar Cancelación</button>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
  margin-top: 24px;
}

.stat-card {
  background: white;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
}

.stat-label {
  font-size: 13px;
  color: var(--text-light);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 8px;
}

.stat-value {
  font-size: 32px;
  font-weight: 700;
  color: var(--dark);
}

.tabs {
  display: flex;
  gap: 8px;
  margin-bottom: 24px;
  border-bottom: 2px solid var(--border);
  overflow-x: auto;
}

.tab {
  padding: 12px 24px;
  border: none;
  background: none;
  cursor: pointer;
  font-weight: 500;
  color: var(--text-light);
  border-bottom: 2px solid transparent;
  margin-bottom: -2px;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 8px;
}

.tab:hover {
  color: var(--primary);
}

.tab.active {
  color: var(--primary);
  border-bottom-color: var(--primary);
}

.tab-badge {
  background: var(--primary);
  color: white;
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 12px;
  font-weight: 600;
}

.tab.active .tab-badge {
  background: white;
  color: var(--primary);
}

#reservasTable .table tbody td {
  padding: 16px 12px !important;
  vertical-align: middle !important;
}

.espacio-cell {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  min-height: 56px;
}

.espacio-icon {
  width: 40px !important;
  height: 40px !important;
  min-width: 40px !important;
  min-height: 40px !important;
  border-radius: 8px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  font-size: 20px !important;
  flex-shrink: 0 !important;
  line-height: 1 !important;
}

.espacio-info {
  display: flex !important;
  flex-direction: column !important;
  gap: 2px !important;
  min-width: 0;
  flex: 1;
}

.espacio-nombre {
  font-weight: 600;
  color: var(--dark);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.espacio-tipo {
  font-size: 12px;
  color: var(--text-light);
  white-space: nowrap;
}

.fecha-cell {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.fecha-date {
  font-weight: 600;
  color: var(--dark);
  font-size: 15px;
}

.fecha-time {
  font-size: 13px;
  color: var(--text-light);
  font-weight: 400;
}

/* Botones de paginación Mis Reservas */
#misReservasPaginationButtons button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}
}

.pagination-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(5, 150, 105, 0.1) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.pagination-btn:hover:not(:disabled) {
  background: linear-gradient(145deg, #ffffff 0%, #f1f5f9 100%);
  color: #334155;
  transform: translateY(-2px) scale(1.05);
  box-shadow: 
    0 6px 20px rgba(0, 0, 0, 0.12),
    0 2px 6px rgba(0, 0, 0, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.6);
}

.pagination-btn:hover:not(:disabled)::before {
  opacity: 1;
}

.pagination-btn.active {
  background: linear-gradient(145deg, #10B981 0%, #059669 100%);
  color: white;
  box-shadow: 
    0 8px 25px rgba(16, 185, 129, 0.35),
    0 4px 12px rgba(5, 150, 105, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
  transform: scale(1.05);
  border: 1px solid rgba(5, 150, 105, 0.6);
  z-index: 2;
}

.pagination-btn.active::before {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.1) 100%);
  opacity: 1;
}

.pagination-btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
  color: #94a3b8;
  background: linear-gradient(145deg, #f1f5f9 0%, #e2e8f0 100%);
  box-shadow: none;
  transform: none;
}

.pagination-btn:disabled:hover {
  transform: none;
  box-shadow: none;
}

.pagination-btn:disabled::before {
  display: none;
}

.pagination-dots {
  padding: 0 8px;
  color: #94a3b8;
  font-weight: 700;
  font-size: 16px;
  user-select: none;
  letter-spacing: 2px;
}

.pagination-nav {
  position: relative;
  padding: 0;
  border: none;
  background: linear-gradient(145deg, #f1f5f9 0%, #e2e8f0 100%);
  border-radius: 12px;
  cursor: pointer;
  font-weight: 600;
  color: #64748b;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid rgba(226, 232, 240, 0.8);
  box-shadow: 
    0 2px 8px rgba(0, 0, 0, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.4);
  overflow: hidden;
}

.pagination-nav::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(66, 153, 225, 0.1) 0%, rgba(49, 130, 206, 0.1) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.pagination-nav:hover:not(:disabled) {
  background: linear-gradient(145deg, #ffffff 0%, #f8fafc 100%);
  color: #475569;
  transform: translateY(-2px) scale(1.05);
  box-shadow: 
    0 6px 20px rgba(0, 0, 0, 0.12),
    0 2px 6px rgba(0, 0, 0, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.6);
}

.pagination-nav:hover:not(:disabled)::before {
  opacity: 1;
}

.pagination-nav:disabled {
  opacity: 0.25;
  cursor: not-allowed;
  background: linear-gradient(145deg, #f8fafc 0%, #e2e8f0 100%);
  transform: none;
  box-shadow: none;
}

.pagination-nav:disabled:hover {
  transform: none;
  box-shadow: none;
}

.pagination-nav:disabled::before {
  display: none;
}

.pagination-nav svg {
  width: 18px;
  height: 18px;
  stroke-width: 2.5;
}

/* Información de paginación con estilo */
#paginationInfo {
  background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
  padding: 12px 20px;
  border-radius: 12px;
  font-size: 14px;
  color: #475569;
  font-weight: 500;
  border: 1px solid rgba(226, 232, 240, 0.6);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  letter-spacing: 0.3px;
  text-align: center;
  backdrop-filter: blur(5px);
  margin-top: 8px;
  display: none;
}

.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  align-items: center;
  justify-content: center;
}
.modal.active {
  display: flex;
}
.modal-content {
  background: white;
  padding: 24px;
  border-radius: var(--radius);
  max-width: 500px;
  width: 90%;
  max-height: 90vh;
  overflow-y: auto;
}
</style>

<script>
  // @ts-nocheck
  
  // Validar autenticación al cargar la página
  const token = localStorage.getItem('token');
  const userCheck = JSON.parse(localStorage.getItem('user') || '{}');
  
  if (!token || !userCheck.id) {
    sessionStorage.setItem('redirectAfterLogin', window.location.pathname);
    
    // Mostrar modal de confirmación y esperar respuesta del usuario
    (async () => {
      const wantsLogin = await showConfirm(
        'Necesitas iniciar sesión para ver tus reservas. ¿Deseas ir a la página de inicio de sesión?',
        'Acceso Restringido',
        '🔒'
      );
      
      if (wantsLogin) {
        window.location.href = '/login';
      } else {
        window.location.href = '/';
      }
    })();
    
    // Detener la ejecución del resto del script
    throw new Error('No authenticated');
  }
  
  let reservas = [];
  let reservasFiltradas = [];
  let estadoActual = 'todas';
  let reservaACancelar = null;
  let paginaActual = 1;
  const itemsPorPagina = 5;
  
  function getTipoIcon(tipo) {
    const icons = {
