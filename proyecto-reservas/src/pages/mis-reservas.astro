        color: '#fbbf24',
        bg: '#fef9c3'
      },
      'pingpong': {
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="15" r="6"/><path d="M14 15h7"/><circle cx="16.5" cy="17.5" r="1.5"/></svg>',
        color: '#f472b6',
        bg: '#fce7f3'
      },
      'yoga': {
        icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="3"/><path d="M12 10v4"/><path d="M9 17l3-3 3 3"/><path d="M6 21l6-6 6 6"/></svg>',
        color: '#a3e635',
        bg: '#ecfccb'
      },
    };
    return icons[tipo] || { 
      icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>',
      color: '#64748B', 
      bg: '#F1F5F9' 
    };
  }
  
  function formatTipo(tipo) {
    const tipos = {
      'futbol5': 'Fútbol 5',
      'futbol7': 'Fútbol 7',
      'futbol11': 'Fútbol 11',
      'basquet': 'Básquet',
      'voley': 'Vóley',
      'piscina': 'Piscina',
      'gimnasio': 'Gimnasio',
      'tenis': 'Tenis',
      'padel': 'Pádel',
      'pingpong': 'Ping Pong',
      'yoga': 'Yoga',
      'boxeo': 'Boxeo',
      'pilates': 'Pilates',
      'artes_marciales': 'Artes Marciales',
    };
    return tipos[tipo] || tipo;
  }
  
  function actualizarEstadisticas() {
    const total = reservas.length;
    const pendientes = reservas.filter(r => r.estado === 'pendiente').length;
    
    // Debug: mostrar estados actuales
    const estadosCount = {};
    reservas.forEach(r => {
      estadosCount[r.estado] = (estadosCount[r.estado] || 0) + 1;
    });
    console.log('Estados de reservas:', estadosCount);
    
    // Calcular próximas reservas (pendientes y confirmadas futuras)
    const ahora = new Date();
    ahora.setHours(0, 0, 0, 0);
    const proximas = reservas.filter(r => {
      // Solo 'pendiente' y 'confirmada' (no incluir 'completada' ni 'cancelada')
      if (r.estado !== 'pendiente' && r.estado !== 'confirmada') return false;
      
      // Comparar solo fechas, no horas  
      const fechaReserva = new Date(r.fecha);
      fechaReserva.setHours(0, 0, 0, 0);
      
      return fechaReserva >= ahora;
    }).length;
    
    console.log('Próximas reservas en mis-reservas:', proximas);
    
    document.getElementById('totalReservas').textContent = total;
    document.getElementById('totalPendientes').textContent = pendientes;
    document.getElementById('badgePendiente').textContent = pendientes;
    
    console.log(`Estadísticas actualizadas: Total=${total}, Pendientes=${pendientes}, Próximas=${proximas}`);
    
    // Llenar el select de tipos
    const tipos = [...new Set(reservas.map(r => r.espacio.tipo))];
    const tipoSelect = document.getElementById('tipoFiltro');
    tipoSelect.innerHTML = '<option value="">Todos</option>' + 
      tipos.map(tipo => `<option value="${tipo}">${formatTipo(tipo)}</option>`).join('');
  }
  
  async function actualizarReservasPasadas() {
    const ahora = new Date();
    const token = localStorage.getItem('token');
    let actualizadas = 0;
    
    for (const reserva of reservas) {
      // Solo procesar reservas confirmadas
      if (reserva.estado !== 'confirmada') continue;
      
      // Parsear fecha y hora
      const fechaReserva = new Date(reserva.fecha);
      const [horaFin, minutoFin] = reserva.horaFin.split(':').map(Number);
      
      // Crear fecha/hora completa de fin de reserva
      const fechaHoraFin = new Date(fechaReserva);
      fechaHoraFin.setHours(horaFin, minutoFin, 0, 0);
      
      // Si ya pasó la hora de fin, marcar como completada
      if (fechaHoraFin < ahora) {
        try {
          const response = await fetch(`/api/reservas/${reserva.id}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ estado: 'completada' })
          });
          
          if (response.ok) {
            reserva.estado = 'completada';
            actualizadas++;
            console.log(`Reserva ${reserva.id} actualizada a completada`);
          }
        } catch (error) {
          console.error(`Error al actualizar reserva ${reserva.id}:`, error);
        }
      }
    }
    
    if (actualizadas > 0) {
      console.log(`${actualizadas} reservas actualizadas automáticamente a completadas`);
    }
  }
  
  async function cargarReservas() {
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    
    if (!user.id) {
      window.location.href = '/login';
      return;
    }
    
    const loading = document.getElementById('loading');
    const table = document.getElementById('reservasTable');
    const noReservas = document.getElementById('noReservas');
    
    try {
      const token = localStorage.getItem('token');
      
      // Siempre filtrar por usuarioId - "Mis Reservas" es personal
      const response = await fetch(`/api/reservas?usuarioId=${user.id}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await response.json();
      
      console.log('Respuesta de reservas:', data);
      
      loading.style.display = 'none';
      
      if (data.success) {
        reservas = data.data || [];
        console.log('Total reservas cargadas:', reservas.length);
        
        // Actualizar automáticamente las reservas pasadas a completadas
        await actualizarReservasPasadas();
        
        // Recalcular estadísticas después de actualizar estados
        actualizarEstadisticas();
        
        if (reservas.length === 0) {
          noReservas.style.display = 'block';
          noReservas.innerHTML = `
            <p style="color: var(--text-light);">No tienes reservas aún</p>
            <a href="/reservar" class="btn btn-primary mt-3">Hacer una Reserva</a>
          `;
        } else {
          table.style.display = 'block';
          aplicarFiltros();
        }
      } else {
        loading.innerHTML = `<div class="alert alert-error">${data.error || 'Error al cargar reservas'}</div>`;
      }
    } catch (error) {
      console.error('Error al cargar reservas:', error);
      loading.innerHTML = '<div class="alert alert-error">Error al cargar reservas. Por favor, recarga la página.</div>';
    }
  }
  
  function aplicarFiltros() {
    let filtradas = reservas;
    
    // Filtrar por estado
    if (estadoActual !== 'todas') {
      if (estadoActual === 'proximas') {
        // Próximas: reservas pendientes o confirmadas con fecha futura
        const ahora = new Date();
        ahora.setHours(0, 0, 0, 0); // Comparar solo días
        
        filtradas = filtradas.filter(r => {
          // Solo 'pendiente' y 'confirmada' (no incluir 'completada')
          if (r.estado !== 'pendiente' && r.estado !== 'confirmada') return false;
          
          // Comparar solo fechas, no horas
          const fechaReserva = new Date(r.fecha);
          fechaReserva.setHours(0, 0, 0, 0);
          
          return fechaReserva >= ahora;
        });
      } else {
        filtradas = filtradas.filter(r => r.estado === estadoActual);
      }
    }
    
    // Filtrar por fecha
    const fechaFiltro = document.getElementById('fechaFiltro').value;
    if (fechaFiltro) {
      filtradas = filtradas.filter(r => {
        const fechaReserva = new Date(r.fecha).toISOString().split('T')[0];
        return fechaReserva === fechaFiltro;
      });
    }
    
    // Filtrar por tipo
    const tipoFiltro = document.getElementById('tipoFiltro').value;
    if (tipoFiltro) {
      filtradas = filtradas.filter(r => r.espacio.tipo === tipoFiltro);
    }
    
    reservasFiltradas = filtradas;
    paginaActual = 1;
    mostrarReservas();
  }
  
  function mostrarReservas() {
    const tbody = document.getElementById('reservasBody');
    const table = document.getElementById('reservasTable');
    const noReservas = document.getElementById('noReservas');
    
    if (reservasFiltradas.length === 0) {
      table.style.display = 'none';
      noReservas.style.display = 'block';
      
      let mensaje = '';
      if (estadoActual === 'todas') {
        mensaje = 'No tienes reservas';
      } else if (estadoActual === 'proximas') {
        mensaje = 'No tienes próximas reservas';
      } else {
        mensaje = `No tienes reservas ${estadoActual}s`;
      }
      
      noReservas.innerHTML = `
        <p style="color: var(--text-light);">${mensaje}</p>
        <a href="/reservar" class="btn btn-primary mt-3">Hacer una Reserva</a>
      `;
      return;
    }
    
    noReservas.style.display = 'none';
    table.style.display = 'block';
    
    // Calcular paginación
    const inicio = (paginaActual - 1) * itemsPorPagina;
    const fin = inicio + itemsPorPagina;
    const reservasPagina = reservasFiltradas.slice(inicio, fin);
    
    tbody.innerHTML = reservasPagina.map(r => {
      const iconInfo = getTipoIcon(r.espacio.tipo);
      return `
      <tr>
        <td style="font-weight: 600; color: var(--text-light);">#${r.id}</td>
        <td>
          <div style="display: flex; align-items: center; gap: 12px;">
            <div style="width: 40px; height: 40px; min-width: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 20px; background: ${iconInfo.bg}; color: ${iconInfo.color}; flex-shrink: 0;">
              ${iconInfo.icon}
            </div>
            <div style="display: flex; flex-direction: column; gap: 2px;">
              <div style="font-weight: 600; color: var(--dark);">${r.espacio.nombre}</div>
              <div style="font-size: 12px; color: var(--text-light);">${formatTipo(r.espacio.tipo)}</div>
            </div>
          </div>
        </td>
        <td>
          <div class="fecha-cell">
            <div class="fecha-date" style="font-weight: 700;">${formatFecha(r.fecha)}</div>
            <div class="fecha-time">${r.horaInicio} - ${r.horaFin}</div>
          </div>
        </td>
        <td><span class="badge badge-${getBadgeColor(r.estado)}">${r.estado.toUpperCase()}</span></td>
        <td style="font-weight: 600;">S/ ${r.montoPagado || 0}</td>
        <td>
          <div class="flex gap-1">
            ${r.estado === 'pendiente' ? 
              `<button class="btn btn-sm btn-danger" onclick="abrirModalCancelar(${r.id})">Cancelar</button>` : 
              r.estado === 'confirmada' ? '<span style="color: var(--text-light); font-size: 13px;">Comprometido</span>' : ''}
          </div>
        </td>
      </tr>
    `}).join('');
    
    // Actualizar info de paginación abajo
    const from = reservasFiltradas.length === 0 ? 0 : (inicio + 1);
    const to = reservasFiltradas.length === 0 ? 0 : Math.min(fin, reservasFiltradas.length);
    const total = reservasFiltradas.length;
    document.getElementById('misReservasFrom').textContent = from;
    document.getElementById('misReservasTo').textContent = to;
    document.getElementById('misReservasTotal').textContent = total;
    mostrarPaginacion();
  }
  
  function mostrarPaginacion() {
    const totalPaginas = Math.ceil(reservasFiltradas.length / itemsPorPagina);
    const wrapper = document.getElementById('pagination');
    const info = document.getElementById('paginationInfo');
    
    if (totalPaginas <= 1) {
      wrapper.style.display = 'none';
      info.style.display = 'none';
      return;
    }
    
    wrapper.style.display = 'flex';
    info.style.display = 'none';
    
    // Crear el contenedor de paginación
    let html = '<div class="pagination-container">';
    
    html += `
      <button 
        class="pagination-nav" 
        onclick="cambiarPagina(1)" 
        ${paginaActual === 1 ? 'disabled' : ''}
        title="Primera página"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="m11 17-5-5 5-5M18 17l-5-5 5-5"/>
        </svg>
      </button>
      <button 
        class="pagination-nav" 
        onclick="cambiarPagina(${paginaActual - 1})" 
        ${paginaActual === 1 ? 'disabled' : ''}
        title="Página anterior"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="m15 18-6-6 6-6"/>
        </svg>
      </button>
    `;
    
    // Lógica para mostrar páginas
    const mostrarPaginas = [];
    
    if (totalPaginas <= 7) {
      // Mostrar todas las páginas si son 7 o menos
      for (let i = 1; i <= totalPaginas; i++) {
        mostrarPaginas.push(i);
      }
    } else {
      // Lógica más inteligente para muchas páginas
      mostrarPaginas.push(1);
      
      if (paginaActual <= 4) {
        for (let i = 2; i <= 5; i++) {
          mostrarPaginas.push(i);
        }
        mostrarPaginas.push('...');
      } else if (paginaActual >= totalPaginas - 3) {
        mostrarPaginas.push('...');
        for (let i = totalPaginas - 4; i <= totalPaginas - 1; i++) {
          mostrarPaginas.push(i);
        }
      } else {
        mostrarPaginas.push('...');
        for (let i = paginaActual - 1; i <= paginaActual + 1; i++) {
          mostrarPaginas.push(i);
        }
        mostrarPaginas.push('...');
      }
      
      if (!mostrarPaginas.includes(totalPaginas)) {
        mostrarPaginas.push(totalPaginas);
      }
    }
    
    mostrarPaginas.forEach(pagina => {
      if (pagina === '...') {
        html += '<span class="pagination-dots">•••</span>';
      } else {
        html += `
          <button 
            class="pagination-btn ${pagina === paginaActual ? 'active' : ''}"
            onclick="cambiarPagina(${pagina})"
          >
            ${pagina}
          </button>
        `;
      }
    });
    
    html += `
      <button 
        class="pagination-nav" 
        onclick="cambiarPagina(${paginaActual + 1})" 
        ${paginaActual === totalPaginas ? 'disabled' : ''}
        title="Página siguiente"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="m9 18 6-6-6-6"/>
        </svg>
      </button>
      <button 
        class="pagination-nav" 
        onclick="cambiarPagina(${totalPaginas})" 
        ${paginaActual === totalPaginas ? 'disabled' : ''}
        title="Última página"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="m6 17 5-5-5-5M13 17l5-5-5-5"/>
        </svg>
      </button>
    `;
    
    html += '</div>'; // Cerrar pagination-container
    
    wrapper.innerHTML = html;
  }
  
  window.cambiarPagina = (pagina) => {
    const totalPaginas = Math.ceil(reservasFiltradas.length / itemsPorPagina);
    if (pagina < 1 || pagina > totalPaginas) return;
    paginaActual = pagina;
    mostrarReservas();
  };
  
  function formatFecha(fecha) {
    // Si la fecha ya es un objeto Date válido
    let fechaObj = fecha;
    
    // Si la fecha viene como string (ISO o YYYY-MM-DD)
    if (typeof fecha === 'string') {
      // Intentar formato YYYY-MM-DD
      if (fecha.includes('-') && !fecha.includes('T')) {
        fechaObj = new Date(fecha + 'T00:00:00');
      } else {
        fechaObj = new Date(fecha);
      }
    }
    
    // Verificar que sea válida
    if (isNaN(fechaObj.getTime())) {
      return 'Fecha inválida';
    }
    
    return fechaObj.toLocaleDateString('es-ES', { 
      day: '2-digit', 
      month: '2-digit', 
      year: 'numeric' 
    });
  }
  
  function getBadgeColor(estado) {
    const colors = {
      'pendiente': 'warning',
      'confirmada': 'success',
      'completada': 'info',
      'cancelada': 'secondary'
    };
    return colors[estado] || 'secondary';
  }
  
  window.abrirModalCancelar = (id) => {
    reservaACancelar = id;
    document.getElementById('cancelModal').classList.add('active');
    document.getElementById('motivoCancelacion').value = '';
    document.getElementById('cancelAlert').innerHTML = '';
  };
  
  window.cerrarModal = () => {
    document.getElementById('cancelModal').classList.remove('active');
    reservaACancelar = null;
  };
  
  document.getElementById('confirmarCancelar').addEventListener('click', async () => {
    const btn = document.getElementById('confirmarCancelar');
    const alertDiv = document.getElementById('cancelAlert');
    const motivo = document.getElementById('motivoCancelacion').value;
    
    btn.disabled = true;
    btn.textContent = 'Cancelando...';
    alertDiv.innerHTML = '';
    
    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`/api/reservas/${reservaACancelar}`, {
        method: 'DELETE',
        headers: { 
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ motivoCancelacion: motivo || null }),
      });
      
      const data = await response.json();
      
      if (data.success) {
        alertDiv.innerHTML = '<div class="alert alert-success">Reserva cancelada exitosamente</div>';
        setTimeout(() => {
          cerrarModal();
          cargarReservas();
        }, 1500);
      } else {
        alertDiv.innerHTML = `<div class="alert alert-error">${data.error}</div>`;
        btn.disabled = false;
        btn.textContent = 'Confirmar Cancelación';
      }
    } catch (error) {
      alertDiv.innerHTML = '<div class="alert alert-error">Error al cancelar reserva</div>';
      btn.disabled = false;
      btn.textContent = 'Confirmar Cancelación';
    }
  });
  
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      estadoActual = tab.dataset.estado;
      aplicarFiltros();
    });
  });
  
  // Event listeners para filtros
  document.getElementById('fechaFiltro').addEventListener('change', aplicarFiltros);
  document.getElementById('tipoFiltro').addEventListener('change', aplicarFiltros);
  
  cargarReservas();
</script>
