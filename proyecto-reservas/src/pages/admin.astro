---
// Panel de administrador
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout title="Panel de Administración">
  <Navbar />

  <div class="container">
    <h1 class="mb-4">Panel de Administración</h1>

    <!-- Tabs de navegación -->
    <div
      class="mb-4"
      style="border-bottom: 2px solid var(--border); display: flex; gap: 16px;"
    >
      <button class="tab-btn active" onclick="cambiarTab('reservas')">
        Reservas
      </button>
      <button class="tab-btn" onclick="cambiarTab('bloqueos')">
        Bloqueos de Mantenimiento
      </button>
      <button class="tab-btn" onclick="cambiarTab('espacios')">
        Espacios
      </button>
    </div>

    <!-- Tab: Reservas -->
    <div id="tabReservas" class="tab-content active">
      <!-- Estadísticas -->
      <div class="grid grid-4 mb-4" id="statsGrid">
        <div class="card stat-card">
          <div class="stat-icon" style="background: #FEF3C7;">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#F59E0B"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
              ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
                x1="12"
                y1="17"
                x2="12.01"
                y2="17"></line></svg
            >
          </div>
          <div>
            <div
              style="font-size: 13px; color: var(--text-light); margin-bottom: 4px;"
            >
              Pendientes
            </div>
            <div
              style="font-size: 32px; font-weight: 700; color: var(--dark);"
              id="statPendientes"
            >
              -
            </div>
          </div>
        </div>
        <div class="card stat-card">
          <div class="stat-icon" style="background: #D1FAE5;">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#10B981"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline
                points="22 4 12 14.01 9 11.01"></polyline></svg
            >
          </div>
          <div>
            <div
              style="font-size: 13px; color: var(--text-light); margin-bottom: 4px;"
            >
              Confirmadas
            </div>
            <div
              style="font-size: 32px; font-weight: 700; color: var(--dark);"
              id="statConfirmadas"
            >
              -
            </div>
          </div>
        </div>
        <div class="card stat-card">
          <div class="stat-icon" style="background: #DBEAFE;">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#3B82F6"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"
              ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                x1="8"
                y1="2"
                x2="8"
                y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg
            >
          </div>
          <div>
            <div
              style="font-size: 13px; color: var(--text-light); margin-bottom: 4px;"
            >
              Hoy
            </div>
            <div
              style="font-size: 32px; font-weight: 700; color: var(--dark);"
              id="statHoy"
            >
              -
            </div>
          </div>
        </div>
        <div class="card stat-card">
          <div class="stat-icon" style="background: #E0E7FF;">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#6366F1"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="3" y="4" width="18" height="18" rx="2" ry="2"
              ></rect><line x1="16" y1="2" x2="16" y2="6"></line><line
                x1="8"
                y1="2"
                x2="8"
                y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg
            >
          </div>
          <div>
            <div
              style="font-size: 13px; color: var(--text-light); margin-bottom: 4px;"
            >
              Total Mes
            </div>
            <div
              style="font-size: 32px; font-weight: 700; color: var(--dark);"
              id="statTotal"
            >
              -
            </div>
          </div>
        </div>
      </div>

      <!-- Filtros -->
      <div class="card mb-4">
        <div class="grid grid-4 gap-3">
          <div>
            <label class="form-label" for="fechaFilter">Fecha</label>
            <input type="date" class="form-input" id="fechaFilter" />
          </div>
          <div>
            <label class="form-label" for="espacioFilter">Espacio</label>
            <select class="form-select" id="espacioFilter">
              <option value="">Todos los espacios</option>
            </select>
          </div>
          <div>
            <label class="form-label" for="estadoFilter">Estado</label>
            <select class="form-select" id="estadoFilter">
              <option value="">Todos los estados</option>
              <option value="pendiente">Pendiente</option>
              <option value="confirmada">Confirmada</option>
              <option value="completada">Completada</option>
              <option value="cancelada">Cancelada</option>
            </select>
          </div>
          <div style="display: flex; align-items: flex-end;">
            <button
              class="btn btn-secondary btn-block"
              onclick="limpiarFiltros()">Limpiar</button
            >
          </div>
        </div>
      </div>

      <!-- Tabla de reservas -->
      <div class="card">
        <div class="flex-between mb-3">
          <h2 class="card-title">Todas las Reservas</h2>
          <div id="conteoReservas" style="color: var(--text-light);"></div>
        </div>

        <div id="loading" class="text-center" style="padding: 40px;">
          <div class="loading" style="width: 40px; height: 40px;"></div>
          <p class="mt-2">Cargando reservas...</p>
        </div>

        <div id="reservasTable" style="display: none;">
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Usuario</th>
                  <th>Espacio</th>
                  <th>Fecha</th>
                  <th>Horario</th>
                  <th>Estado</th>
                  <th>Monto</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody id="reservasBody"> </tbody>
            </table>
          </div>
        </div>
        <!-- Paginación Reservas -->
        <div
          id="reservasPagination"
          style="display: none; padding: 16px 24px; background: white; border-top: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center;"
        >
          <div
            style="font-size: 13px; color: var(--text-light);"
            id="reservasPaginationInfo"
          >
            Mostrando <span id="reservasFrom">1</span> a <span id="reservasTo"
              >10</span
            > de <span id="reservasTotal">0</span> reservas
          </div>
          <div style="display: flex; gap: 12px;" id="reservasPaginationButtons">
            <button
              class="btn btn-sm"
              onclick="cambiarPaginaReservas('prev')"
              id="reservasPrevBtn"
              style="padding: 8px 18px; font-size: 14px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 8px; font-weight: 600; box-shadow: 0 2px 8px rgba(16,185,129,0.08); transition: background 0.2s; display: flex; align-items: center; gap: 6px;"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                style="vertical-align: middle;"
                ><path d="M15 18l-6-6 6-6"></path></svg
              >
              Anterior
            </button>
            <button
              class="btn btn-sm"
              onclick="cambiarPaginaReservas('next')"
              id="reservasNextBtn"
              style="padding: 8px 18px; font-size: 14px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 8px; font-weight: 600; box-shadow: 0 2px 8px rgba(16,185,129,0.08); transition: background 0.2s; display: flex; align-items: center; gap: 6px;"
            >
              Siguiente
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                style="vertical-align: middle;"
                ><path d="M9 18l6-6-6-6"></path></svg
              >
            </button>
          </div>
        </div>

        <div
          id="noReservas"
          style="display: none; text-align: center; padding: 40px; color: var(--text-light);"
        >
          No hay reservas que coincidan con los filtros
        </div>
      </div>
    </div>
    <!-- Fin Tab: Reservas -->

    <!-- Tab: Bloqueos -->
    <div id="tabBloqueos" class="tab-content" style="display: none;">
      <!-- Botón crear bloqueo -->
      <div class="mb-4">
        <button class="btn btn-primary" onclick="abrirModalBloqueo()">
          + Nuevo Bloqueo de Mantenimiento
        </button>
      </div>

      <!-- Filtros de bloqueos -->
      <div class="card mb-4">
        <div class="grid grid-3 gap-3">
          <div>
            <label class="form-label" for="bloqueoEspacioFilter">Espacio</label>
            <select class="form-select" id="bloqueoEspacioFilter">
              <option value="">Todos los espacios</option>
            </select>
          </div>
          <div>
            <label class="form-label" for="bloqueoActivoFilter">Estado</label>
            <select class="form-select" id="bloqueoActivoFilter">
              <option value="">Todos</option>
              <option value="true">Activos</option>
              <option value="false">Inactivos</option>
            </select>
          </div>
          <div style="display: flex; align-items: flex-end;">
            <button class="btn btn-secondary" onclick="limpiarFiltrosBloqueos()"
              >Limpiar</button
            >
          </div>
        </div>
      </div>

      <!-- Lista de bloqueos -->
      <div id="loadingBloqueos" class="text-center" style="padding: 40px;">
        <div class="loading" style="width: 40px; height: 40px;"></div>
        <p class="mt-2">Cargando bloqueos...</p>
      </div>

      <div id="bloqueosTable" style="display: none;">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Espacio</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Horario</th>
                <th>Motivo</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="bloqueosBody"> </tbody>
          </table>
        </div>
      </div>

      <div
        id="bloqueosPagination"
        style="display: none; padding: 16px 24px; background: white; border-top: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center;"
      >
        <div style="font-size: 13px; color: var(--text-light);" id="bloqueosPaginationInfo">
          Mostrando <span id="bloqueosFrom">1</span> a <span id="bloqueosTo">10</span> de <span id="bloqueosTotal">0</span> bloqueos
        </div>
        <div style="display: flex; gap: 12px;" id="bloqueosPaginationButtons">
          <button class="btn btn-sm" onclick="cambiarPaginaBloqueos('prev')" id="bloqueosPrevBtn" style="padding: 8px 18px; font-size: 14px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 8px; font-weight: 600; box-shadow: 0 2px 8px rgba(16,185,129,0.08); transition: background 0.2s; display: flex; align-items: center; gap: 6px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align: middle;"><path d="M15 18l-6-6 6-6"></path></svg>
            Anterior
          </button>
          <button class="btn btn-sm" onclick="cambiarPaginaBloqueos('next')" id="bloqueosNextBtn" style="padding: 8px 18px; font-size: 14px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 8px; font-weight: 600; box-shadow: 0 2px 8px rgba(16,185,129,0.08); transition: background 0.2s; display: flex; align-items: center; gap: 6px;">
            Siguiente
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="vertical-align: middle;"><path d="M9 6l6 6-6 6"></path></svg>
          </button>
        </div>
      </div>
      <div
        id="noBloqueos"
        style="display: none; text-align: center; padding: 40px; color: var(--text-light);"
      >
        No hay bloqueos registrados
      </div>
    </div>
    <!-- Fin Tab: Bloqueos -->

    <!-- Tab: Espacios -->
    <div id="tabEspacios" class="tab-content">
      <div
        style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;"
      >
        <div>
          <h2 style="margin: 0 0 4px 0;">Gestión de Espacios</h2>
          <p style="margin: 0; color: var(--text-light); font-size: 14px;">
            Administra y configura las áreas deportivas disponibles.
          </p>
        </div>
        <button class="btn btn-primary" onclick="abrirModalEspacio()">
          + Nuevo Espacio
        </button>
      </div>

      <div id="espaciosAlert"></div>

      <!-- Tabla de espacios -->
      <div class="card">
        <div class="table-responsive">
          <table id="espaciosTable" class="table" style="display: none;">
            <thead>
              <tr>
                <th>#</th>
                <th>Nombre del Espacio</th>
                <th>Tipo</th>
                <th>Capacidad</th>
                <th>Precio</th>
                <th>Características</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="espaciosBody"></tbody>
          </table>
        </div>
        <div
          id="noEspacios"
          style="display: none; text-align: center; padding: 40px; color: var(--text-light);"
        >
          No hay espacios registrados
        </div>
        <!-- Paginación -->
        <div
          id="espaciosPagination"
          style="display: none; padding: 16px 24px; background: white; border-top: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center;"
        >
          <div
            style="font-size: 13px; color: var(--text-light);"
            id="espaciosPaginationInfo"
          >
            Mostrando <span id="espaciosFrom">1</span> a <span id="espaciosTo"
              >10</span
            > de <span id="espaciosTotal">8</span> espacios
          </div>
          <div style="display: flex; gap: 12px;" id="espaciosPaginationButtons">
            <button
              class="btn btn-sm"
              onclick="cambiarPaginaEspacios('prev')"
              id="espaciosPrevBtn"
              style="padding: 8px 18px; font-size: 14px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 8px; font-weight: 600; box-shadow: 0 2px 8px rgba(16,185,129,0.08); transition: background 0.2s; display: flex; align-items: center; gap: 6px;"
            >
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                style="vertical-align: middle;"
                ><path d="M15 18l-6-6 6-6"></path></svg
              >
              Anterior
            </button>
            <button
              class="btn btn-sm"
              onclick="cambiarPaginaEspacios('next')"
              id="espaciosNextBtn"
              style="padding: 8px 18px; font-size: 14px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; border: none; border-radius: 8px; font-weight: 600; box-shadow: 0 2px 8px rgba(16,185,129,0.08); transition: background 0.2s; display: flex; align-items: center; gap: 6px;"
            >
              Siguiente
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                style="vertical-align: middle;"
                ><path d="M9 18l6-6-6-6"></path></svg
              >
            </button>
          </div>
        </div>
      </div>
    </div>
    <!-- Fin Tab: Espacios -->
  </div>
  <!-- Fin container -->

  <!-- Modal de confirmación -->
  <div id="actionModal" class="modal">
    <div class="modal-content" style="padding: 32px; max-width: 480px;">
      <h3
        style="margin-bottom: 20px; font-size: 22px; font-weight: 700; color: var(--dark);"
        id="actionModalTitle"
      >
      </h3>
      <div id="actionModalAlert"></div>
      <p
        id="actionModalMessage"
        style="margin-bottom: 24px; color: var(--text); line-height: 1.6; font-size: 16px;"
      >
      </p>
      <div
        class="form-group"
        id="motivoGroup"
        style="display: none; margin-bottom: 24px;"
      >
        <label class="form-label" for="motivoInput">Motivo de cancelación</label
        >
        <textarea
          class="form-textarea"
          id="motivoInput"
          placeholder="Ingresa el motivo de la cancelación"
          style="min-height: 80px;"></textarea>
      </div>
      <div class="flex gap-2" style="justify-content: center;">
        <button
          class="btn btn-secondary"
          onclick="cerrarModal()"
          style="min-width: 120px;">Cancelar</button
        >
        <button
          class="btn btn-primary"
          id="confirmarAccion"
          style="min-width: 120px;">Confirmar</button
        >
      </div>
    </div>
  </div>

  <!-- Modal de bloqueo -->
  <div id="bloqueoModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 style="margin: 0;">Nuevo Bloqueo de Mantenimiento</h3>
      </div>

      <div class="modal-body">
        <div id="bloqueoAlert"></div>

        <form id="bloqueoForm">
          <div class="form-group-modal">
            <label class="form-label" for="bloqueoEspacio">Espacio *</label>
            <select class="form-select" id="bloqueoEspacio" required>
              <option value="">Seleccione un espacio</option>
            </select>
          </div>

          <div class="grid grid-2 gap-3">
            <div class="form-group-modal">
              <label class="form-label" for="bloqueoFechaInicio"
                >Fecha Inicio *</label
              >
              <input
                type="date"
                class="form-input"
                id="bloqueoFechaInicio"
                required
              />
            </div>
            <div class="form-group-modal">
              <label class="form-label" for="bloqueoFechaFin">Fecha Fin *</label
              >
              <input
                type="date"
                class="form-input"
                id="bloqueoFechaFin"
                required
              />
            </div>
          </div>

          <!-- Mensaje cuando es rango de días -->
          <div
            id="mensajeRangoDias"
            style="display: none; padding: 12px; background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 8px; color: #1E40AF; font-size: 14px; margin-bottom: 12px;"
          >
            ℹ️ <strong>Bloqueo de varios días:</strong> Se bloqueará todo el día para
            el rango de fechas seleccionado.
          </div>

          <!-- Opciones de horario (solo para un día) -->
          <div id="opcionesHorario">
            <div class="form-group-modal">
              <label
                style="display: flex; align-items: center; gap: 8px; cursor: pointer;"
              >
                <input type="checkbox" id="bloqueoTodoElDia" />
                <span>Bloquear todo el día</span>
              </label>
            </div>

            <div class="grid grid-2 gap-3" id="horariosGroup">
              <div class="form-group-modal">
                <label class="form-label" for="bloqueoHoraInicio"
                  >Hora Inicio *</label
                >
                <input
                  type="time"
                  class="form-input"
                  id="bloqueoHoraInicio"
                  required
                />
              </div>
              <div class="form-group-modal">
                <label class="form-label" for="bloqueoHoraFin">Hora Fin *</label
                >
                <input
                  type="time"
                  class="form-input"
                  id="bloqueoHoraFin"
                  required
                />
              </div>
            </div>
          </div>

          <div class="form-group-modal" style="margin-bottom: 0;">
            <label class="form-label" for="bloqueoMotivo">Motivo *</label>
            <input
              type="text"
              class="form-input"
              id="bloqueoMotivo"
              placeholder="Ej: Mantenimiento de pasto"
              required
            />
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <div class="flex gap-2" style="justify-content: flex-end;">
          <button
            type="button"
            class="btn btn-secondary"
            onclick="cerrarModalBloqueo()">Cancelar</button
          >
          <button type="submit" form="bloqueoForm" class="btn btn-primary"
            >Crear Bloqueo</button
          >
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de Espacio -->
  <div id="espacioModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 style="margin: 0;">Nuevo Espacio Deportivo</h3>
      </div>

      <div class="modal-body">
        <div id="espacioAlert"></div>

        <form id="espacioForm">
          <div class="form-group-modal">
            <label class="form-label" for="espacioNombre">Nombre *</label>
            <input
              type="text"
              class="form-input"
              id="espacioNombre"
              required
              placeholder="Ej: Cancha Fútbol 5 - A"
            />
          </div>

          <div class="form-group-modal">
            <label class="form-label" for="espacioTipo">Tipo *</label>
            <select class="form-select" id="espacioTipo" required>
              <option value="">Seleccione un tipo</option>
              <option value="futbol5">Fútbol 5</option>
              <option value="futbol7">Fútbol 7</option>
              <option value="futbol11">Fútbol 11</option>
              <option value="basquet">Basquet</option>
              <option value="voley">Vóley</option>
              <option value="piscina">Piscina</option>
              <option value="gimnasio">Gimnasio</option>
              <option value="tenis">Tenis</option>
              <option value="padel">Padel</option>
              <option value="pingpong">Pingpong</option>
              <option value="yoga">Yoga</option>
              <option value="pilates">Pilates</option>
              <option value="boxeo">Boxeo</option>
              <option value="artes_marciales">Artes Marciales</option>
            </select>
          </div>

          <div class="grid grid-2 gap-3">
            <div class="form-group-modal">
              <label class="form-label" for="espacioCapacidad"
                >Capacidad *</label
              >
              <input
                type="number"
                class="form-input"
                id="espacioCapacidad"
                required
                min="1"
                placeholder="10"
              />
            </div>

            <div class="form-group-modal">
              <label class="form-label" for="espacioOrden">Orden</label>
              <input
                type="number"
                class="form-input"
                id="espacioOrden"
                value="0"
                min="0"
              />
            </div>
          </div>

          <div class="grid grid-2 gap-3">
            <div class="form-group-modal">
              <label class="form-label" for="espacioPrecioHora"
                >Precio/Hora (S/) *</label
              >
              <input
                type="number"
                class="form-input"
                id="espacioPrecioHora"
                required
                min="0"
                step="0.01"
                placeholder="50.00"
              />
            </div>
          </div>

          <div class="form-group-modal">
            <label class="form-label" for="espacioDescripcion"
              >Descripción</label
            >
            <textarea
              class="form-textarea"
              id="espacioDescripcion"
              rows="3"
              placeholder="Descripción del espacio deportivo..."></textarea>
          </div>

          <div class="form-group-modal" style="margin-bottom: 0;">
            <label class="form-label" style="margin-bottom: 12px;"
              >Características</label
            >
            <div
              style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;"
            >
              <label
                style="display: flex; align-items: center; gap: 8px; cursor: pointer;"
              >
                <input type="checkbox" id="espacioTechado" />
                <span>Techado</span>
              </label>
              <label
                style="display: flex; align-items: center; gap: 8px; cursor: pointer;"
              >
                <input type="checkbox" id="espacioIluminacion" checked />
                <span>Iluminación</span>
              </label>
              <label
                style="display: flex; align-items: center; gap: 8px; cursor: pointer;"
              >
                <input type="checkbox" id="espacioVestuarios" checked />
                <span>Vestuarios</span>
              </label>
              <label
                style="display: flex; align-items: center; gap: 8px; cursor: pointer;"
              >
                <input type="checkbox" id="espacioEstacionamiento" />
                <span>Estacionamiento</span>
              </label>
            </div>
          </div>
        </form>
      </div>

      <div class="modal-footer">
        <div class="flex gap-2" style="justify-content: flex-end;">
          <button
            type="button"
            class="btn btn-secondary"
            onclick="cerrarModalEspacio()">Cancelar</button
          >
          <button type="submit" form="espacioForm" class="btn btn-primary" id="espacioSubmitBtn"
            >Crear Espacio</button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .stat-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px;
  }

  .stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1000;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.2s;
  }
  .modal.active {
    display: flex;
  }
  .modal-content {
    background: white;
    padding: 0;
    border-radius: 16px;
    max-width: 600px;
    width: 90%;
    max-height: 90vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: slideUp 0.3s;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      transform: translateY(20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .modal-header {
    border-bottom: 2px solid #e5e7eb;
    padding: 24px 24px 16px 24px;
    margin-bottom: 0;
  }

  .modal-body {
    padding: 20px 24px;
    overflow-y: auto;
    flex: 1;
    min-height: 0;
  }

  .modal-footer {
    border-top: 2px solid #e5e7eb;
    padding: 16px 24px 24px 24px;
    margin-top: 0;
    background: white;
  }

  .form-group-modal {
    margin-bottom: 14px;
  }

  /* === ESTILOS DE TABS === */
  .tabs {
    display: flex;
    border-bottom: 2px solid #e5e7eb;
    margin-bottom: 24px;
    gap: 0;
  }

  .tab-btn {
    padding: 14px 28px;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    font-weight: 600;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 16px;
    position: relative;
    outline: none;
  }

  .tab-btn:hover {
    color: #374151;
    background: rgba(59, 130, 246, 0.08);
    border-bottom-color: rgba(59, 130, 246, 0.3);
  }

  .tab-btn.active {
    color: #2563eb;
    border-bottom-color: #2563eb;
    background: rgba(59, 130, 246, 0.1);
  }

  .tab-content {
    display: none;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
  }

  .tab-content.active {
    display: block !important;
    opacity: 1;
    transform: translateY(0);
  }

  #tabBloqueos.active {
    display: block !important;
    visibility: visible !important;
    min-height: 400px;
  }

  #tabReservas.active {
    display: block !important;
    visibility: visible !important;
  }

  /* Estilos para tabla de espacios */
  #espaciosTable tbody tr {
    transition: background-color 0.15s ease;
  }

  #espaciosTable tbody tr:hover {
    background-color: #f9fafb !important;
  }

  #espaciosTable tbody tr:last-child {
    border-bottom: none;
  }

  /* Botones de paginación */
  #espaciosPaginationButtons button:disabled,
  #reservasPaginationButtons button:disabled,
  #bloqueosPaginationButtons button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<script>
  // @ts-nocheck
  let todasReservas = [];
  let reservasFiltradas = [];
  // Paginación reservas
  let paginaReservas = 1;
  let reservasPorPagina = 10;

  window.cambiarPaginaReservas = function (direccion) {
    const totalPaginas = Math.ceil(
      reservasFiltradas.length / reservasPorPagina,
    );
    if (direccion === "prev" && paginaReservas > 1) {
      paginaReservas--;
    } else if (direccion === "next" && paginaReservas < totalPaginas) {
      paginaReservas++;
    }
    mostrarReservas();
  }

  function actualizarPaginacionReservas() {
    const pagDiv = document.getElementById("reservasPagination");
    const info = document.getElementById("reservasPaginationInfo");
    const from = document.getElementById("reservasFrom");
    const to = document.getElementById("reservasTo");
    const total = document.getElementById("reservasTotal");
    const prevBtn = document.getElementById("reservasPrevBtn");
    const nextBtn = document.getElementById("reservasNextBtn");
    const totalPaginas = Math.ceil(
      reservasFiltradas.length / reservasPorPagina,
    );
    if (reservasFiltradas.length === 0) {
      pagDiv.style.display = "none";
      return;
    }
    pagDiv.style.display = "flex";
    let desde = reservasFiltradas.length === 0 ? 0 : (paginaReservas - 1) * reservasPorPagina + 1;
    let hasta = reservasFiltradas.length === 0 ? 0 : Math.min(paginaReservas * reservasPorPagina, reservasFiltradas.length);
    from.textContent = desde;
    to.textContent = hasta;
    total.textContent = reservasFiltradas.length;
    prevBtn.disabled = paginaReservas === 1 || reservasFiltradas.length === 0;
    nextBtn.disabled = paginaReservas >= totalPaginas || reservasFiltradas.length === 0;
  }
  let espacios = [];
  let accionActual = null;

  async function verificarAdmin() {
    const user = JSON.parse(localStorage.getItem("user") || "{}");

    if (!user.id) {
      window.location.href = "/login";
      return false;
    }

    if (user.rol !== "admin") {
      showError("No tienes permisos de administrador", "Acceso Denegado", "🚫");
      setTimeout(() => {
        window.location.href = "/espacios";
      }, 2000);
      return false;
    }

    return true;
  }

  async function cargarEspacios() {
    try {
      const response = await fetch("/api/espacios");
      const data = await response.json();

      if (data.success) {
        espacios = data.data;
        const select = document.getElementById("espacioFilter");
        if (select) {
          select.innerHTML =
            '<option value="">Todos los espacios</option>' +
            espacios
              .map((e) => `<option value="${e.id}">${e.nombre}</option>`)
              .join("");
        }
      }
    } catch (error) {
      console.error("Error al cargar espacios:", error);
    }
  }

  async function cargarReservas() {
    if (!(await verificarAdmin())) return;

    const loading = document.getElementById("loading");
    const table = document.getElementById("reservasTable");

    try {
      const token = localStorage.getItem("token");
      const response = await fetch("/api/reservas", {
        headers: { Authorization: `Bearer ${token}` },
      });
      const data = await response.json();

      if (loading) loading.style.display = "none";

      if (data.success) {
        todasReservas = data.data;

        // Marcar automáticamente como completadas las reservas pasadas
        await marcarReservasPasadasComoCompletadas();

        reservasFiltradas = todasReservas;
        if (table) table.style.display = "block";
        mostrarReservas();
        actualizarEstadisticas();
      }
    } catch (error) {
      if (loading)
        loading.innerHTML =
          '<div class="alert alert-error">Error al cargar reservas</div>';
    }
  }

  async function marcarReservasPasadasComoCompletadas() {
    const ahora = new Date();
    const token = localStorage.getItem("token");

    for (const reserva of todasReservas) {
      // Solo procesar reservas confirmadas
      if (reserva.estado !== "confirmada") continue;

      // Parsear fecha y hora
      const fechaReserva = new Date(reserva.fecha);
      const [horaFin, minutoFin] = reserva.horaFin.split(":").map(Number);

      // Crear fecha/hora completa de fin de reserva
      const fechaHoraFin = new Date(fechaReserva);
      fechaHoraFin.setHours(horaFin, minutoFin, 0, 0);

      // Si ya pasó la hora de fin, marcar como completada
      if (fechaHoraFin < ahora) {
        try {
          const response = await fetch(`/api/reservas/${reserva.id}`, {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ estado: "completada" }),
          });

          if (response.ok) {
            reserva.estado = "completada";
          }
        } catch (error) {
          console.error(`Error al actualizar reserva ${reserva.id}:`, error);
        }
      }
    }
  }

  function actualizarEstadisticas() {
    const hoy = new Date().toISOString().split("T")[0];
    const mesActual = new Date().getMonth();
    const añoActual = new Date().getFullYear();

    const statPendientes = document.getElementById("statPendientes");
    const statConfirmadas = document.getElementById("statConfirmadas");
    const statHoy = document.getElementById("statHoy");
    const statTotal = document.getElementById("statTotal");

    if (statPendientes) {
      statPendientes.textContent = todasReservas
        .filter((r) => r.estado === "pendiente")
        .length.toString();
    }

    if (statConfirmadas) {
      statConfirmadas.textContent = todasReservas
        .filter((r) => r.estado === "confirmada")
        .length.toString();
    }

    if (statHoy) {
      statHoy.textContent = todasReservas
        .filter((r) => r.fecha === hoy)
        .length.toString();
    }

    if (statTotal) {
      statTotal.textContent = todasReservas
        .filter((r) => {
          const fecha = new Date(r.fecha);
          return (
            fecha.getMonth() === mesActual && fecha.getFullYear() === añoActual
          );
        })
        .length.toString();
    }
  }

  function aplicarFiltros() {
    const fechaFilter = document.getElementById("fechaFilter");
    const espacioFilter = document.getElementById("espacioFilter");
    const estadoFilter = document.getElementById("estadoFilter");

    const fecha = fechaFilter?.value || "";
    const espacioId = espacioFilter?.value || "";
    const estado = estadoFilter?.value || "";

    reservasFiltradas = todasReservas.filter((r) => {
      if (fecha && r.fecha !== fecha) return false;
      if (espacioId && r.espacioId !== parseInt(espacioId)) return false;
      if (estado && r.estado !== estado) return false;
      return true;
    });

    mostrarReservas();
  }

  function mostrarReservas() {
    const tbody = document.getElementById("reservasBody");
    const noReservas = document.getElementById("noReservas");
    const table = document.getElementById("reservasTable");
    const conteo = document.getElementById("conteoReservas");

    if (conteo) {
      conteo.textContent = `Mostrando ${reservasFiltradas.length} de ${todasReservas.length} reservas`;
    }

    if (reservasFiltradas.length === 0) {
      if (table) table.style.display = "none";
      if (noReservas) noReservas.style.display = "block";
      actualizarPaginacionReservas();
      return;
    }

    if (table) table.style.display = "block";
    if (noReservas) noReservas.style.display = "none";

    if (tbody) {
      const inicio = (paginaReservas - 1) * reservasPorPagina;
      const fin = inicio + reservasPorPagina;
      tbody.innerHTML = reservasFiltradas
        .slice(inicio, fin)
        .map((r) => {
          // Verificar si la reserva ya pasó
          const fechaReserva = new Date(r.fecha);
          const [horaFin, minutoFin] = r.horaFin.split(":").map(Number);
          const fechaHoraFin = new Date(fechaReserva);
          fechaHoraFin.setHours(horaFin, minutoFin, 0, 0);
          const yaPaso = fechaHoraFin < new Date();

          return `
      <tr>
        <td>#${r.id}</td>
        <td>
          <div>${r.usuario.nombre} ${r.usuario.apellido || ""}</div>
          <div style="font-size: 12px; color: var(--text-light);">${r.usuario.email}</div>
        </td>
        <td>${r.espacio.nombre}</td>
        <td>${formatFecha(r.fecha)}</td>
        <td>${r.horaInicio} - ${r.horaFin}</td>
        <td><span class="badge badge-${getBadgeColor(r.estado)}">${r.estado.toUpperCase()}</span></td>
        <td>S/ ${r.montoPagado || 0}</td>
        <td>
          <div class="flex gap-1" style="flex-wrap: wrap;">
            ${
              r.estado === "pendiente"
                ? `<button class="btn btn-sm btn-success" onclick="cambiarEstado(${r.id}, 'confirmada')">Confirmar</button>`
                : ""
            }
            ${
              r.estado === "confirmada" && yaPaso
                ? `<button class="btn btn-sm btn-info" onclick="cambiarEstado(${r.id}, 'completada')">Completar</button>`
                : ""
            }
            ${
              r.estado !== "cancelada" && r.estado !== "completada"
                ? `<button class="btn btn-sm btn-danger" onclick="abrirModalCancelar(${r.id})">Cancelar</button>`
                : ""
            }
          </div>
        </td>
      </tr>
    `;
        })
        .join("");
    }
    actualizarPaginacionReservas();
  }

  function formatFecha(fecha) {
    // Si la fecha ya es un objeto Date válido
    let fechaObj = fecha;

    // Si la fecha viene como string (ISO o YYYY-MM-DD)
    if (typeof fecha === "string") {
      // Intentar formato YYYY-MM-DD
      if (fecha.includes("-") && !fecha.includes("T")) {
        fechaObj = new Date(fecha + "T00:00:00");
      } else {
        fechaObj = new Date(fecha);
      }
    }

    // Verificar que sea válida
    if (isNaN(fechaObj.getTime())) {
      return "Fecha inválida";
    }

    return fechaObj.toLocaleDateString("es-ES", {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
    });
  }

  function getBadgeColor(estado) {
    const colors = {
      pendiente: "warning",
      confirmada: "success",
      completada: "info",
      cancelada: "secondary",
    };
    return colors[estado] || "secondary";
  }

  window.cambiarEstado = (id, nuevoEstado) => {
    accionActual = { id, tipo: "cambiarEstado", estado: nuevoEstado };

    const modalTitle = document.getElementById("actionModalTitle");
    const modalMessage = document.getElementById("actionModalMessage");
    const motivoGroup = document.getElementById("motivoGroup");
    const confirmarBtn = document.getElementById("confirmarAccion");
    const modalAlert = document.getElementById("actionModalAlert");
    const modal = document.getElementById("actionModal");

    // Mensajes personalizados según el estado
    let titulo = "Cambiar Estado";
    let mensaje = `¿Confirmar cambio de estado a ${nuevoEstado.toUpperCase()}?`;

    if (nuevoEstado === "confirmada") {
      titulo = "Confirmar Reserva";
      mensaje = "¿Confirmar esta reserva?";
    } else if (nuevoEstado === "completada") {
      titulo = "Completar Reserva";
      mensaje = "¿Marcar esta reserva como completada?";
    }

    if (modalTitle) modalTitle.textContent = titulo;
    if (modalMessage) modalMessage.textContent = mensaje;
    if (motivoGroup) motivoGroup.style.display = "none";
    if (confirmarBtn) {
      // Usar verde para confirmar, azul para otros estados
      confirmarBtn.className =
        nuevoEstado === "confirmada" ? "btn btn-success" : "btn btn-primary";
    }
    if (modalAlert) modalAlert.innerHTML = "";
    if (modal) modal.classList.add("active");
  };

  window.abrirModalCancelar = (id) => {
    accionActual = { id, tipo: "cancelar" };

    const modalTitle = document.getElementById("actionModalTitle");
    const modalMessage = document.getElementById("actionModalMessage");
    const motivoGroup = document.getElementById("motivoGroup");
    const motivoInput = document.getElementById("motivoInput");
    const confirmarBtn = document.getElementById("confirmarAccion");
    const modalAlert = document.getElementById("actionModalAlert");
    const modal = document.getElementById("actionModal");

    if (modalTitle) modalTitle.textContent = "Cancelar Reserva";
    if (modalMessage)
      modalMessage.textContent = "¿Estás seguro de cancelar esta reserva?";
    if (motivoGroup) motivoGroup.style.display = "block";
    if (motivoInput) motivoInput.value = "";
    if (confirmarBtn) confirmarBtn.className = "btn btn-danger";
    if (modalAlert) modalAlert.innerHTML = "";
    if (modal) modal.classList.add("active");
  };

  window.cerrarModal = () => {
    const modal = document.getElementById("actionModal");
    if (modal) modal.classList.remove("active");
    accionActual = null;
  };

  // Cerrar modal al hacer clic fuera
  const actionModal = document.getElementById("actionModal");
  if (actionModal) {
    actionModal.addEventListener("click", (e) => {
      if (e.target === actionModal) {
        cerrarModal();
      }
    });
  }

  const btnConfirmar = document.getElementById("confirmarAccion");
  if (btnConfirmar) {
    btnConfirmar.addEventListener("click", async () => {
      if (!accionActual) return;

      const btn = document.getElementById("confirmarAccion");
      const alertDiv = document.getElementById("actionModalAlert");

      if (btn) {
        btn.disabled = true;
        btn.textContent = "Procesando...";
      }
      if (alertDiv) alertDiv.innerHTML = "";

      try {
        const token = localStorage.getItem("token");
        const user = JSON.parse(localStorage.getItem("user") || "{}");

        let response;
        if (accionActual.tipo === "cambiarEstado") {
          response = await fetch(`/api/reservas/${accionActual.id}`, {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({ estado: accionActual.estado }),
          });
        } else if (accionActual.tipo === "cancelar") {
          response = await fetch(`/api/reservas/${accionActual.id}`, {
            method: "DELETE",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({
              motivoCancelacion:
                document.getElementById("motivoInput")?.value || null,
              canceladoPor: user.id,
            }),
          });
        }

        const data = await response.json();

        if (data.success) {
          if (alertDiv)
            alertDiv.innerHTML =
              '<div class="alert alert-success">Operación exitosa</div>';

          // Actualizar la reserva en la lista local en lugar de recargar todo
          if (accionActual.tipo === "cambiarEstado") {
            const reserva = todasReservas.find((r) => r.id === accionActual.id);
            if (reserva) {
              reserva.estado = accionActual.estado;
            }
          } else if (accionActual.tipo === "cancelar") {
            const reserva = todasReservas.find((r) => r.id === accionActual.id);
            if (reserva) {
              reserva.estado = "cancelada";
            }
          }

          setTimeout(() => {
            cerrarModal();
            // Solo actualizar la vista, no recargar desde el servidor
            aplicarFiltros();
            actualizarEstadisticas();
          }, 1000);
        } else {
          if (alertDiv)
            alertDiv.innerHTML = `<div class="alert alert-error">${data.error}</div>`;
          if (btn) {
            btn.disabled = false;
            btn.textContent = "Confirmar";
          }
        }
      } catch (error) {
        if (alertDiv)
          alertDiv.innerHTML =
            '<div class="alert alert-error">Error al procesar operación</div>';
        if (btn) {
          btn.disabled = false;
          btn.textContent = "Confirmar";
        }
      }
    });
  }

  window.limpiarFiltros = () => {
    const fechaFilter = document.getElementById("fechaFilter");
    const espacioFilter = document.getElementById("espacioFilter");
    const estadoFilter = document.getElementById("estadoFilter");

    if (fechaFilter) fechaFilter.value = "";
    if (espacioFilter) espacioFilter.value = "";
    if (estadoFilter) estadoFilter.value = "";

    reservasFiltradas = todasReservas;
    mostrarReservas();
  };

  const fechaFilter = document.getElementById("fechaFilter");
  const espacioFilter = document.getElementById("espacioFilter");
  const estadoFilter = document.getElementById("estadoFilter");

  if (fechaFilter) fechaFilter.addEventListener("change", aplicarFiltros);
  if (espacioFilter) espacioFilter.addEventListener("change", aplicarFiltros);
  if (estadoFilter) estadoFilter.addEventListener("change", aplicarFiltros);

  cargarEspacios();
  cargarReservas();

  // ============================================
  // FUNCIONES DE TABS
  // ============================================

  window.cambiarTab = (tab) => {
    // Actualizar botones
    const tabBtns = document.querySelectorAll(".tab-btn");
    tabBtns.forEach((btn) => btn.classList.remove("active"));

    // Encontrar y activar el botón correcto
    const targetBtn = Array.from(tabBtns).find(
      (btn) =>
        (tab === "reservas" &&
          btn.textContent.includes("Reservas") &&
          !btn.textContent.includes("Bloqueos")) ||
        (tab === "bloqueos" && btn.textContent.includes("Bloqueos")),
    );

    if (targetBtn) {
      targetBtn.classList.add("active");
    }

    // Actualizar contenido - ocultar ambos tabs primero
    const tabReservas = document.getElementById("tabReservas");
    const tabBloqueos = document.getElementById("tabBloqueos");

    if (tabReservas) {
      tabReservas.style.display = "none";
      tabReservas.classList.remove("active");
    }

    if (tabBloqueos) {
      tabBloqueos.style.display = "none";
      tabBloqueos.classList.remove("active");
    }

    // Mostrar el tab correcto
    if (tab === "reservas" && tabReservas) {
      tabReservas.style.display = "block";
      tabReservas.classList.add("active");
    } else if (tab === "bloqueos" && tabBloqueos) {
      tabBloqueos.style.display = "block";
      tabBloqueos.classList.add("active");

      // Mostrar loading inicial
      const loadingEl = document.getElementById("loadingBloqueos");
      const tableEl = document.getElementById("bloqueosTable");
      const noDataEl = document.getElementById("noBloqueos");

      if (loadingEl) loadingEl.style.display = "block";
      if (tableEl) tableEl.style.display = "none";
      if (noDataEl) noDataEl.style.display = "none";

      // Cargar datos de bloqueos
      cargarEspaciosBloqueo();
      cargarBloqueos();
    }
  };

  // ============================================
  // FUNCIONES DE BLOQUEOS
  // ============================================

  let todosBloqueos = [];
  let bloqueosFiltrados = [];
  // Paginación bloqueos
  let paginaBloqueos = 1;
  let bloqueosPorPagina = 10;

  window.cambiarPaginaBloqueos = function (direccion) {
    const totalPaginas = Math.ceil(bloqueosFiltrados.length / bloqueosPorPagina);
    if (direccion === "prev" && paginaBloqueos > 1) {
      paginaBloqueos--;
    } else if (direccion === "next" && paginaBloqueos < totalPaginas) {
      paginaBloqueos++;
    }
    mostrarBloqueos();
  }

  function actualizarPaginacionBloqueos() {
    const pagDiv = document.getElementById("bloqueosPagination");
    const infoDiv = document.getElementById("bloqueosPaginationInfo");
    const prevBtn = document.getElementById("bloqueosPrevBtn");
    const nextBtn = document.getElementById("bloqueosNextBtn");
    const fromSpan = document.getElementById("bloqueosFrom");
    const toSpan = document.getElementById("bloqueosTo");
    const totalSpan = document.getElementById("bloqueosTotal");
    const total = bloqueosFiltrados.length;
    const totalPaginas = Math.ceil(total / bloqueosPorPagina);
    if (total === 0) {
      if (pagDiv) pagDiv.style.display = "none";
      return;
    }
    if (pagDiv) pagDiv.style.display = "flex";
    if (infoDiv) infoDiv.style.display = "block";
    if (fromSpan) fromSpan.textContent = String((paginaBloqueos - 1) * bloqueosPorPagina + 1);
    if (toSpan) toSpan.textContent = String(Math.min(paginaBloqueos * bloqueosPorPagina, total));
    if (totalSpan) totalSpan.textContent = String(total);
    if (prevBtn) prevBtn.disabled = paginaBloqueos === 1;
    if (nextBtn) nextBtn.disabled = paginaBloqueos === totalPaginas || totalPaginas === 0;
  }

  async function cargarBloqueos() {
    const loadingEl = document.getElementById("loadingBloqueos");
    const tableEl = document.getElementById("bloqueosTable");
    const noDataEl = document.getElementById("noBloqueos");

    if (loadingEl) loadingEl.style.display = "block";
    if (tableEl) tableEl.style.display = "none";
    if (noDataEl) noDataEl.style.display = "none";

    try {
      const token = localStorage.getItem("token");

      const espacioFilter =
        document.getElementById("bloqueoEspacioFilter")?.value || "";
      const activoFilter =
        document.getElementById("bloqueoActivoFilter")?.value || "";

      let url = "/api/bloqueos";
      const params = [];
      if (espacioFilter) params.push(`espacioId=${espacioFilter}`);
      if (activoFilter) params.push(`activo=${activoFilter}`);
      if (params.length > 0) url += "?" + params.join("&");

      const response = await fetch(url, {
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      const data = await response.json();

      if (data.success) {
        todosBloqueos = data.data;
        bloqueosFiltrados = todosBloqueos;
        mostrarBloqueos();
      } else {
        if (noDataEl) {
          noDataEl.innerHTML = `<p style="color: red;">Error: ${data.error}</p>`;
          noDataEl.style.display = "block";
        }
      }
    } catch (error) {
      if (noDataEl) {
        noDataEl.innerHTML = `<p style="color: red;">Error al cargar bloqueos: ${error.message}</p>`;
        noDataEl.style.display = "block";
      }
    } finally {
      if (loadingEl) loadingEl.style.display = "none";
    }
  }

  function mostrarBloqueos() {
    const tableEl = document.getElementById("bloqueosTable");
    const bodyEl = document.getElementById("bloqueosBody");
    const noDataEl = document.getElementById("noBloqueos");

    if (!bodyEl) {
      return;
    }

    if (bloqueosFiltrados.length === 0) {
      if (tableEl) tableEl.style.display = "none";
      if (noDataEl) {
        noDataEl.innerHTML = `
          <div style="text-align: center; padding: 40px; color: var(--text-light);">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom: 16px; opacity: 0.5;">
              <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p style="margin-bottom: 16px; font-size: 16px; font-weight: 500;">📅 No hay bloqueos de mantenimiento</p>
            <p style="font-size: 14px; margin-bottom: 24px; opacity: 0.8;">Los espacios están disponibles para reservas en todos los horarios habilitados.</p>
            <button class="btn btn-primary" onclick="abrirModalBloqueo()" style="padding: 12px 24px; font-weight: 600;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              Crear Primer Bloqueo
            </button>
          </div>
        `;
        noDataEl.style.display = "block";
      }
      actualizarPaginacionBloqueos();
      return;
    }

    if (tableEl) tableEl.style.display = "block";
    if (noDataEl) noDataEl.style.display = "none";

    // Paginación
    const total = bloqueosFiltrados.length;
    const inicio = (paginaBloqueos - 1) * bloqueosPorPagina;
    const fin = Math.min(paginaBloqueos * bloqueosPorPagina, total);
    const bloqueosPagina = bloqueosFiltrados.slice(inicio, fin);
    bodyEl.innerHTML = bloqueosPagina
      .map((b) => {
        const fechaInicio = new Date(b.fechaInicio).toLocaleDateString("es-ES");
        const fechaFin = new Date(b.fechaFin).toLocaleDateString("es-ES");
        const horario = b.todoElDia
          ? "Todo el día"
          : `${b.horaInicio} - ${b.horaFin}`;
        const estadoBadge = b.activo
          ? '<span class="badge badge-success">Activo</span>'
          : '<span class="badge badge-secondary">Inactivo</span>';
        return `
        <tr>
          <td>${b.id}</td>
          <td><strong>${b.espacio.nombre}</strong><br><small>${b.espacio.tipo}</small></td>
          <td>${fechaInicio}</td>
          <td>${fechaFin}</td>
          <td>${horario}</td>
          <td>${b.motivo}</td>
          <td>${estadoBadge}</td>
          <td>
            ${b.activo ? `<button class="btn btn-sm btn-danger" onclick="desactivarBloqueo(${b.id})">Desactivar</button>` : ""}
          </td>
        </tr>
      `;
      })
      .join("");
    actualizarPaginacionBloqueos();
  }

  // Función auxiliar para escapar HTML y prevenir problemas de renderizado
  function escapeHtml(text) {
    if (!text) return "";
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  window.desactivarBloqueo = async (id) => {
    const bloqueo = todosBloqueos.find((b) => b.id === id);

    if (!bloqueo) {
      showError(
        "No se encontró el bloqueo. Intenta recargar la página.",
        "Error",
        "❌",
      );
      return;
    }

    const fechaInicio = new Date(bloqueo.fechaInicio).toLocaleDateString(
      "es-ES",
      { day: "2-digit", month: "short", year: "numeric" },
    );
    const fechaFin = new Date(bloqueo.fechaFin).toLocaleDateString("es-ES", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
    const horario = bloqueo.todoElDia
      ? "Todo el día"
      : `${escapeHtml(bloqueo.horaInicio)} - ${escapeHtml(bloqueo.horaFin)}`;

    // Escapar las variables que vienen de la base de datos para evitar romper el HTML
    const nombreEspacio = escapeHtml(bloqueo.espacio?.nombre || "Sin nombre");
    const motivo = escapeHtml(bloqueo.motivo || "Sin motivo especificado");

    const mensaje = `<div style="text-align: left; margin: 16px 0;"><p style="margin-bottom: 12px; font-size: 15px;">Se desactivará el siguiente bloqueo de mantenimiento:</p><div style="background: #F3F4F6; padding: 14px; border-radius: 8px; margin-bottom: 12px;"><p style="margin: 6px 0; font-size: 14px;"><strong>Espacio:</strong> ${nombreEspacio}</p><p style="margin: 6px 0; font-size: 14px;"><strong>Período:</strong> ${fechaInicio} - ${fechaFin}</p><p style="margin: 6px 0; font-size: 14px;"><strong>Horario:</strong> ${horario}</p><p style="margin: 6px 0; font-size: 14px;"><strong>Motivo:</strong> ${motivo}</p></div><p style="color: #059669; margin-top: 12px; font-size: 14px;">✓ Los horarios volverán a estar disponibles para reservas.</p></div>`;

    const confirmed = await showConfirm(
      mensaje,
      "Confirmar Desactivación de Bloqueo",
      "⚠️",
    );

    if (!confirmed) return;

    try {
      const token = localStorage.getItem("token");
      const response = await fetch(`/api/bloqueos/${id}`, {
        method: "DELETE",
        headers: {
          Authorization: `Bearer ${token}`,
        },
      });

      const data = await response.json();

      if (data.success) {
        showSuccess(
          `El bloqueo de <strong>${escapeHtml(bloqueo.espacio?.nombre || "Sin nombre")}</strong> ha sido desactivado. Los horarios ya están disponibles para nuevas reservas.`,
          "¡Bloqueo Desactivado!",
          "✅",
        );
        cargarBloqueos();
      } else {
        showError(
          "Error: " + escapeHtml(data.error || "Error desconocido"),
          "Error",
          "❌",
        );
      }
    } catch (error) {
      console.error("Error:", error);
      showError(
        "No se pudo conectar con el servidor. Verifica tu conexión.",
        "Error de Conexión",
        "❌",
      );
    }
  };

  window.limpiarFiltrosBloqueos = () => {
    const espacioFilter = document.getElementById("bloqueoEspacioFilter");
    const activoFilter = document.getElementById("bloqueoActivoFilter");

    if (espacioFilter) espacioFilter.value = "";
    if (activoFilter) activoFilter.value = "";

    cargarBloqueos();
  };

  // Event listeners para filtros de bloqueos
  const bloqueoEspacioFilter = document.getElementById("bloqueoEspacioFilter");
  const bloqueoActivoFilter = document.getElementById("bloqueoActivoFilter");

  if (bloqueoEspacioFilter)
    bloqueoEspacioFilter.addEventListener("change", cargarBloqueos);
  if (bloqueoActivoFilter)
    bloqueoActivoFilter.addEventListener("change", cargarBloqueos);

  window.limpiarFiltrosBloqueos = () => {
    if (bloqueoEspacioFilter) bloqueoEspacioFilter.value = "";
    if (bloqueoActivoFilter) bloqueoActivoFilter.value = "";
    cargarBloqueos();
  };

  // Inicialización al cargar la página
  document.addEventListener("DOMContentLoaded", () => {
    const tabBloqueos = document.getElementById("tabBloqueos");
    const activeTabBtn = document.querySelector(".tab-btn.active");

    if (
      activeTabBtn &&
      activeTabBtn.textContent.includes("Bloqueos") &&
      tabBloqueos
    ) {
      cargarEspaciosBloqueo();
      cargarBloqueos();
    }
  });

  // ============================================
  // MODAL DE BLOQUEO
  // ============================================

  async function cargarEspaciosBloqueo() {
    try {
      const response = await fetch("/api/espacios");
      const data = await response.json();

      if (data.success) {
        const selectEspacio = document.getElementById("bloqueoEspacio");
        const selectFilter = document.getElementById("bloqueoEspacioFilter");

        if (selectEspacio) {
          selectEspacio.innerHTML =
            '<option value="">Seleccione un espacio</option>' +
            data.data
              .map(
                (e) =>
                  `<option value="${e.id}">${e.nombre} (${e.tipo})</option>`,
              )
              .join("");
        }

        if (selectFilter) {
          selectFilter.innerHTML =
            '<option value="">Todos los espacios</option>' +
            data.data
              .map((e) => `<option value="${e.id}">${e.nombre}</option>`)
              .join("");
        }
      }
    } catch (error) {
      console.error("Error al cargar espacios:", error);
    }
  }

  // Función para verificar si es un solo día o rango
  function verificarRangoFechas() {
    const fechaInicio = document.getElementById("bloqueoFechaInicio")?.value;
    const fechaFin = document.getElementById("bloqueoFechaFin")?.value;
    const mensajeRango = document.getElementById("mensajeRangoDias");
    const opcionesHorario = document.getElementById("opcionesHorario");
    const todoElDiaCheckbox = document.getElementById("bloqueoTodoElDia");
    const horaInicio = document.getElementById("bloqueoHoraInicio");
    const horaFin = document.getElementById("bloqueoHoraFin");

    if (!fechaInicio || !fechaFin) return;

    const esUnSoloDia = fechaInicio === fechaFin;

    if (esUnSoloDia) {
      // Un solo día: mostrar opciones de horario
      if (mensajeRango) mensajeRango.style.display = "none";
      if (opcionesHorario) opcionesHorario.style.display = "block";

      // Restaurar required en los campos de hora (si no está marcado "todo el día")
      if (todoElDiaCheckbox && !todoElDiaCheckbox.checked) {
        if (horaInicio) horaInicio.setAttribute("required", "required");
        if (horaFin) horaFin.setAttribute("required", "required");
      }
    } else {
      // Rango de días: ocultar opciones y mostrar mensaje
      if (mensajeRango) mensajeRango.style.display = "block";
      if (opcionesHorario) opcionesHorario.style.display = "none";

      // Marcar como todo el día automáticamente
      if (todoElDiaCheckbox) todoElDiaCheckbox.checked = true;

      // IMPORTANTE: Remover required de los campos ocultos para evitar error de validación
      if (horaInicio) horaInicio.removeAttribute("required");
      if (horaFin) horaFin.removeAttribute("required");
    }
  }

  window.abrirModalBloqueo = () => {
    const modal = document.getElementById("bloqueoModal");

    if (modal) {
      modal.classList.add("active");
    }

    // Resetear formulario
    const form = document.getElementById("bloqueoForm");
    if (form) {
      form.reset();
    }

    // Configurar fechas mínimas
    const fechaInicio = document.getElementById("bloqueoFechaInicio");
    const fechaFin = document.getElementById("bloqueoFechaFin");
    const hoy = new Date().toISOString().split("T")[0];

    if (fechaInicio) {
      fechaInicio.min = hoy;
      fechaInicio.value = hoy;
    }

    if (fechaFin) {
      fechaFin.min = hoy;
      fechaFin.value = hoy;
    }

    // Configurar event listeners para las fechas
    const setupFechaListeners = () => {
      const inputInicio = document.getElementById("bloqueoFechaInicio");
      const inputFin = document.getElementById("bloqueoFechaFin");

      if (inputInicio) {
        // Remover listener anterior si existe
        inputInicio.removeEventListener("change", handleFechaChange);
        inputInicio.addEventListener("change", handleFechaChange);
      }

      if (inputFin) {
        inputFin.removeEventListener("change", handleFechaChange);
        inputFin.addEventListener("change", handleFechaChange);
      }
    };

    const handleFechaChange = () => {
      const inputInicio = document.getElementById("bloqueoFechaInicio");
      const inputFin = document.getElementById("bloqueoFechaFin");

      if (inputFin && inputInicio && inputInicio.value) {
        inputFin.min = inputInicio.value;
        if (inputFin.value && inputFin.value < inputInicio.value) {
          inputFin.value = inputInicio.value;
        }
      }
      verificarRangoFechas();
    };

    setupFechaListeners();

    // Verificar rango de fechas inicial
    setTimeout(() => verificarRangoFechas(), 100);

    // Verificar que los espacios estén cargados
    const selectEspacio = document.getElementById("bloqueoEspacio");
    if (selectEspacio && selectEspacio.options.length <= 1) {
      cargarEspaciosBloqueo();
    }
  };

  window.cerrarModalBloqueo = () => {
    const modal = document.getElementById("bloqueoModal");
    if (modal) modal.classList.remove("active");
  };

  // Toggle horarios según checkbox (solo cuando es un día)
  const todoElDiaCheckbox = document.getElementById("bloqueoTodoElDia");
  const horariosGroup = document.getElementById("horariosGroup");

  if (todoElDiaCheckbox) {
    todoElDiaCheckbox.addEventListener("change", (e) => {
      if (horariosGroup) {
        horariosGroup.style.display = e.target.checked ? "none" : "grid";
      }

      const horaInicio = document.getElementById("bloqueoHoraInicio");
      const horaFin = document.getElementById("bloqueoHoraFin");

      if (e.target.checked) {
        if (horaInicio) horaInicio.removeAttribute("required");
        if (horaFin) horaFin.removeAttribute("required");
      } else {
        if (horaInicio) horaInicio.setAttribute("required", "required");
        if (horaFin) horaFin.setAttribute("required", "required");
      }
    });
  }

  // Formulario de bloqueo
  const bloqueoForm = document.getElementById("bloqueoForm");
  if (bloqueoForm) {
    bloqueoForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      const alertDiv = document.getElementById("bloqueoAlert");
      const submitBtn = e.target.querySelector('button[type="submit"]');

      // Limpiar alertas previas
      if (alertDiv) alertDiv.innerHTML = "";

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Creando...";
      }

      try {
        const espacioId = document.getElementById("bloqueoEspacio")?.value;
        const fechaInicio =
          document.getElementById("bloqueoFechaInicio")?.value;
        const fechaFin = document.getElementById("bloqueoFechaFin")?.value;
        const todoElDia = document.getElementById("bloqueoTodoElDia")?.checked;
        const horaInicio = document.getElementById("bloqueoHoraInicio")?.value;
        const horaFin = document.getElementById("bloqueoHoraFin")?.value;
        const motivo = document.getElementById("bloqueoMotivo")?.value;

        // Si es rango de días, forzar todo el día
        const esRangoDias = fechaInicio !== fechaFin;
        const esTodoElDia = esRangoDias || todoElDia;

        // Validaciones adicionales del lado del cliente
        if (!espacioId) {
          if (alertDiv)
            alertDiv.innerHTML =
              '<div class="alert alert-error">Debe seleccionar un espacio</div>';
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Crear Bloqueo";
          }
          return;
        }

        if (!fechaInicio || !fechaFin) {
          if (alertDiv)
            alertDiv.innerHTML =
              '<div class="alert alert-error">Las fechas son obligatorias</div>';
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Crear Bloqueo";
          }
          return;
        }

        // Solo validar horarios si es un día y no está marcado todo el día
        if (!esTodoElDia && (!horaInicio || !horaFin)) {
          if (alertDiv)
            alertDiv.innerHTML =
              '<div class="alert alert-error">Los horarios son obligatorios si no es todo el día</div>';
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Crear Bloqueo";
          }
          return;
        }

        if (!motivo || motivo.trim() === "") {
          if (alertDiv)
            alertDiv.innerHTML =
              '<div class="alert alert-error">El motivo es obligatorio</div>';
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Crear Bloqueo";
          }
          return;
        }

        const token = localStorage.getItem("token");
        const response = await fetch("/api/bloqueos", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`,
          },
          body: JSON.stringify({
            espacioId: parseInt(espacioId),
            fechaInicio,
            fechaFin,
            horaInicio: esTodoElDia ? null : horaInicio,
            horaFin: esTodoElDia ? null : horaFin,
            todoElDia: esTodoElDia,
            motivo,
          }),
        });

        const data = await response.json();

        // Si hay conflicto con reservas confirmadas
        if (response.status === 409 && data.requiereConfirmacion) {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Crear Bloqueo";
          }

          // Mostrar lista de reservas afectadas
          let mensajeHTML = `<h4 style="margin-bottom: 16px; color: #f59e0b;">⚠️ ${data.mensaje}</h4>`;
          mensajeHTML += `<div style="text-align: left; margin: 16px 0;">`;
          mensajeHTML += `<p style="margin-bottom: 12px; font-weight: 600;">Reservas que serán canceladas:</p>`;
          mensajeHTML += `<div style="max-height: 200px; overflow-y: auto; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px;">`;

          data.reservasAfectadas.forEach((r, i) => {
            mensajeHTML += `
              <div style="padding: 8px; background: #f9fafb; margin-bottom: 8px; border-radius: 6px; border-left: 3px solid #f59e0b;">
                <div style="font-weight: 600; color: #1e293b;">${i + 1}. ${r.usuario}</div>
                <div style="font-size: 13px; color: #64748b;">${r.email}</div>
                <div style="font-size: 13px; color: #64748b; margin-top: 4px;">
                  📅 ${r.fecha} | ⏰ ${r.horaInicio} - ${r.horaFin}
                </div>
                <div style="font-size: 12px; margin-top: 4px;">
                  <span style="background: #fef3c7; color: #92400e; padding: 2px 8px; border-radius: 12px; font-weight: 500;">
                    ${r.estado.toUpperCase()}
                  </span>
                </div>
              </div>
            `;
          });

          mensajeHTML += `</div></div>`;
          mensajeHTML += `<p style="margin-top: 16px; font-size: 14px; color: #64748b;">¿Desea crear el bloqueo y cancelar automáticamente estas reservas?</p>`;

          const confirmar = await showConfirm(
            mensajeHTML,
            "Confirmar Bloqueo",
            "⚠️",
          );

          if (confirmar) {
            // Reenviar con forzarCancelacion: true
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.textContent = "Cancelando reservas...";
            }

            try {
              const response2 = await fetch("/api/bloqueos", {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Authorization: `Bearer ${token}`,
                },
                body: JSON.stringify({
                  espacioId: parseInt(espacioId),
                  fechaInicio,
                  fechaFin,
                  horaInicio: esTodoElDia ? null : horaInicio,
                  horaFin: esTodoElDia ? null : horaFin,
                  todoElDia: esTodoElDia,
                  motivo,
                  forzarCancelacion: true, // 🔑 Confirmación
                }),
              });

              const data2 = await response2.json();

              if (data2.success) {
                let mensaje = "Bloqueo creado exitosamente";
                if (data2.reservasCanceladas > 0) {
                  mensaje += ` y se cancelaron ${data2.reservasCanceladas} reserva(s)`;
                }
                showSuccess(mensaje, "¡Éxito!");
                setTimeout(() => {
                  cerrarModalBloqueo();
                  cargarBloqueos();
                  cargarReservas();
                }, 1500);
              } else {
                if (alertDiv)
                  alertDiv.innerHTML = `<div class="alert alert-error">Error: ${data2.error || "Error al forzar cancelación"}</div>`;
                if (submitBtn) {
                  submitBtn.disabled = false;
                  submitBtn.textContent = "Crear Bloqueo";
                }
              }
            } catch (error) {
              console.error("Error al forzar:", error);
              if (alertDiv)
                alertDiv.innerHTML = `<div class="alert alert-error">Error: ${error.message}</div>`;
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = "Crear Bloqueo";
              }
            }
          } else {
            // Usuario canceló
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = "Crear Bloqueo";
            }
          }
          return;
        }

        // Respuesta normal
        if (data.success) {
          if (alertDiv)
            alertDiv.innerHTML =
              '<div class="alert alert-success">Bloqueo creado exitosamente</div>';
          setTimeout(() => {
            cerrarModalBloqueo();
            cargarBloqueos();
          }, 1000);
        } else {
          if (alertDiv)
            alertDiv.innerHTML = `<div class="alert alert-error">Error: ${data.error || "Error desconocido"}</div>`;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Crear Bloqueo";
          }
        }
      } catch (error) {
        console.error("Error:", error);
        if (alertDiv)
          alertDiv.innerHTML = `<div class="alert alert-error">Error de conexión: ${error.message}</div>`;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Crear Bloqueo";
        }
      }
    });
  }

  // ========================================
  // GESTIÓN DE TABS
  // ========================================
  window.cambiarTab = function (tab) {
    // Actualizar botones
    const botones = document.querySelectorAll(".tab-btn");
    botones.forEach((btn) => btn.classList.remove("active"));
    event.target.classList.add("active");

    // Mostrar/ocultar contenido
    document.getElementById("tabReservas").classList.remove("active");
    document.getElementById("tabBloqueos").classList.remove("active");
    document.getElementById("tabEspacios").classList.remove("active");

    if (tab === "reservas") {
      document.getElementById("tabReservas").classList.add("active");
      cargarReservas();
    } else if (tab === "bloqueos") {
      document.getElementById("tabBloqueos").classList.add("active");
      cargarBloqueos();
    } else if (tab === "espacios") {
      document.getElementById("tabEspacios").classList.add("active");
      cargarTodosEspacios();
    }
  };

  // ========================================
  // GESTIÓN DE ESPACIOS
  // ========================================
  let todosEspacios = [];
  let paginaActualEspacios = 1;
  const espaciosPorPagina = 10;

  async function cargarTodosEspacios() {
    try {
      const response = await fetch("/api/espacios?activo=all");
      const data = await response.json();

      const table = document.getElementById("espaciosTable");
      const noEspacios = document.getElementById("noEspacios");
      const pagination = document.getElementById("espaciosPagination");

      if (data.success && data.data.length > 0) {
        todosEspacios = data.data;
        paginaActualEspacios = 1; // Resetear a página 1
        mostrarEspaciosPaginados();

        if (table) table.style.display = "table";
        if (noEspacios) noEspacios.style.display = "none";
        if (pagination) pagination.style.display = "flex";
      } else {
        if (table) table.style.display = "none";
        if (noEspacios) noEspacios.style.display = "block";
        if (pagination) pagination.style.display = "none";
      }
    } catch (error) {
      console.error("Error al cargar espacios:", error);
    }
  }

  function mostrarEspaciosPaginados() {
    const tbody = document.getElementById("espaciosBody");
    const inicio = (paginaActualEspacios - 1) * espaciosPorPagina;
    const fin = inicio + espaciosPorPagina;
    const espaciosPagina = todosEspacios.slice(inicio, fin);

    const totalPaginas = Math.ceil(todosEspacios.length / espaciosPorPagina);

    if (tbody) {
      tbody.innerHTML = espaciosPagina
        .map(
          (e) => `
        <tr style="vertical-align: middle; border-bottom: 1px solid #f3f4f6; transition: background 0.15s;">
          <td style="text-align: center; font-weight: 600; color: #9ca3af; font-size: 13px; padding: 16px 8px;">
            ${e.id}
          </td>
          <td style="padding: 16px;">
            <div style="font-weight: 600; color: #2563eb; margin-bottom: 2px; font-size: 14px;">${e.nombre}</div>
            ${e.descripcion ? `<div style=\"font-size: 12px; color: #6b7280; max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;\">${e.descripcion}</div>` : ""}
          </td>
          <td style="padding: 16px; text-align: center; vertical-align: middle; white-space: nowrap;">
            <span class="badge" style="background: ${getTipoColor(e.tipo)}; color: white; font-size: 13px; padding: 6px 18px; border-radius: 6px; font-weight: 600; display: inline-block; min-width: 80px; letter-spacing: 0.5px;">${formatTipo(e.tipo)}</span>
          </td>
          <td style="text-align: center; padding: 16px;">
            <div style="font-weight: 600; color: #111827; font-size: 16px;">${e.capacidad}</div>
            <div style="font-size: 11px; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.3px;">PERSONAS</div>
          </td>
          <td style="text-align: center; padding: 16px 20px; vertical-align: middle; white-space: nowrap;">
            <span style="font-weight: 700; color: #10b981; font-size: 18px; letter-spacing: 0.5px;">S/ ${e.precioHora.toFixed(2)}</span>
          </td>
          <td style="padding: 16px;">
            <div style="display: flex; flex-wrap: wrap; gap: 6px; font-size: 11px;">
              ${e.techado ? '<span style=\"color: #3b82f6; white-space: nowrap;\">✓ Techado</span>' : ""}
              ${e.iluminacion ? '<span style=\"color: #f59e0b; white-space: nowrap;\">💡 Iluminación</span>' : ""}
              ${e.vestuarios ? '<span style=\"color: #10b981; white-space: nowrap;\">🚿 Vestuarios</span>' : ""}
              ${e.estacionamiento ? '<span style=\"color: #8b5cf6; white-space: nowrap;\">🅿 Estacionamiento</span>' : ""}
            </div>
          </td>
          <td style="text-align: center; padding: 16px; vertical-align: middle; white-space: nowrap;">
            <span class="badge badge-${e.activo ? "success" : "secondary"}" style="font-size: 13px; padding: 6px 18px; font-weight: 600; border-radius: 6px; min-width: 90px; display: inline-block; letter-spacing: 0.5px;">
              ${e.activo ? "● ACTIVO" : "○ INACTIVO"}
            </span>
          </td>
          <td style="text-align: center; padding: 16px; display: flex; gap: 6px; justify-content: center; align-items: center;">
            <button 
              class="btn btn-sm btn-primary" 
              onclick="editarEspacio(${e.id})"
              style="min-width: 70px; font-size: 11px; padding: 6px 10px; border-radius: 5px;"
            >
              ✎ Editar
            </button>
            <button 
              class="btn btn-sm ${e.activo ? "btn-danger" : "btn-success"}" 
              onclick="toggleEstadoEspacio(${e.id}, ${!e.activo})"
              style="min-width: 90px; font-size: 11px; padding: 6px 10px; border-radius: 5px;"
            >
              ${e.activo ? "⊗ Desactivar" : "✓ Activar"}
            </button>
          </td>
        </tr>
      `,
        )
        .join("");
    }

    // Actualizar info de paginación
    document.getElementById("espaciosFrom").textContent = inicio + 1;
    document.getElementById("espaciosTo").textContent = Math.min(
      fin,
      todosEspacios.length,
    );
    document.getElementById("espaciosTotal").textContent = todosEspacios.length;

    // Actualizar botones
    const prevBtn = document.getElementById("espaciosPrevBtn");
    const nextBtn = document.getElementById("espaciosNextBtn");

    if (prevBtn) prevBtn.disabled = paginaActualEspacios === 1;
    if (nextBtn) nextBtn.disabled = paginaActualEspacios >= totalPaginas;
  }

  window.cambiarPaginaEspacios = function (direccion) {
    const totalPaginas = Math.ceil(todosEspacios.length / espaciosPorPagina);

    if (direccion === "prev" && paginaActualEspacios > 1) {
      paginaActualEspacios--;
    } else if (direccion === "next" && paginaActualEspacios < totalPaginas) {
      paginaActualEspacios++;
    }

    mostrarEspaciosPaginados();
  };

  function getTipoColor(tipo) {
    const colores = {
      futbol5: "#10b981",
      futbol7: "#059669",
      futbol11: "#047857",
      basquet: "#f59e0b",
      voley: "#3b82f6",
      piscina: "#06b6d4",
      gimnasio: "#8b5cf6",
      tenis: "#ec4899",
    };
    return colores[tipo] || "#6b7280";
  }

  function formatTipo(tipo) {
    const tipos = {
      futbol5: "Fútbol 5",
      futbol7: "Fútbol 7",
      futbol11: "Fútbol 11",
      basquet: "Basquet",
      voley: "Vóley",
      piscina: "Piscina",
      gimnasio: "Gimnasio",
      tenis: "Tenis",
      padel: "Padel",
      pingpong: "Pingpong",
      yoga: "Yoga",
      pilates: "Pilates",
      boxeo: "Boxeo",
      artes_marciales: "Artes Marciales",
    };
    return (
      tipos[tipo] ||
      tipo.charAt(0).toUpperCase() + tipo.slice(1).replace(/_/g, " ")
    );
  }


  // Variable global para saber si estamos editando o creando
  let espacioEditando = null;

  window.abrirModalEspacio = function () {
    espacioEditando = null;
    const modal = document.getElementById("espacioModal");
    const form = document.getElementById("espacioForm");
    const alertDiv = document.getElementById("espacioAlert");
    const titulo = modal?.querySelector(".modal-header h3");
    if (titulo) titulo.textContent = "Nuevo Espacio Deportivo";
    if (form) form.reset();
    if (alertDiv) alertDiv.innerHTML = "";
    // Cambiar texto del botón
    const submitBtn = document.getElementById("espacioSubmitBtn");
    if (submitBtn) submitBtn.textContent = "Crear Espacio";
    if (modal) modal.classList.add("active");
  };

  window.editarEspacio = function (id) {
    const espacio = todosEspacios.find(e => e.id === id);
    if (!espacio) return;
    espacioEditando = espacio;
    const modal = document.getElementById("espacioModal");
    const form = document.getElementById("espacioForm");
    const alertDiv = document.getElementById("espacioAlert");
    const titulo = modal?.querySelector(".modal-header h3");
    if (titulo) titulo.textContent = "Editar Espacio Deportivo";
    if (form) {
      form.reset();
      // Llenar campos
      document.getElementById("espacioNombre").value = espacio.nombre || "";
      document.getElementById("espacioTipo").value = espacio.tipo || "";
      document.getElementById("espacioCapacidad").value = espacio.capacidad || "";
      document.getElementById("espacioPrecioHora").value = espacio.precioHora || "";
      document.getElementById("espacioDescripcion").value = espacio.descripcion || "";
      document.getElementById("espacioTechado").checked = !!espacio.techado;
      document.getElementById("espacioIluminacion").checked = !!espacio.iluminacion;
      document.getElementById("espacioVestuarios").checked = !!espacio.vestuarios;
      document.getElementById("espacioEstacionamiento").checked = !!espacio.estacionamiento;
      document.getElementById("espacioOrden").value = espacio.orden || 0;
      // Cambiar texto del botón
      const submitBtn = document.getElementById("espacioSubmitBtn");
      if (submitBtn) submitBtn.textContent = "Guardar Cambios";
    }
    if (alertDiv) alertDiv.innerHTML = "";
    if (modal) modal.classList.add("active");
  };

  window.cerrarModalEspacio = function () {
    const modal = document.getElementById("espacioModal");
    if (modal) modal.classList.remove("active");
  };

  // Modal informativo reutilizando actionModal
  function mostrarModalInfo(titulo, mensaje, tipo = "info") {
    const modal = document.getElementById("actionModal");
    const modalTitle = document.getElementById("actionModalTitle");
    const modalMessage = document.getElementById("actionModalMessage");
    const motivoGroup = document.getElementById("motivoGroup");
    const confirmarBtn = document.getElementById("confirmarAccion");
    const modalAlert = document.getElementById("actionModalAlert");
    if (modalTitle) modalTitle.textContent = titulo;
    if (modalMessage) modalMessage.innerHTML = mensaje;
    if (motivoGroup) motivoGroup.style.display = "none";
    if (modalAlert) modalAlert.innerHTML = "";
    if (confirmarBtn) {
      confirmarBtn.style.display = "none";
    }
    if (modal) {
      modal.classList.add("active");
    }
    // Cerrar modal al hacer clic en Cancelar
    const cancelarBtn = modal.querySelector(".btn.btn-secondary");
    if (cancelarBtn) cancelarBtn.textContent = "Cerrar";
  }

  window.toggleEstadoEspacio = async function (id, nuevoEstado) {
    const confirmMsg = nuevoEstado
      ? "¿Seguro que deseas ACTIVAR este espacio? Volverá a estar disponible para reservas."
      : "¿Seguro que deseas DESACTIVAR este espacio? Se cancelarán automáticamente todas las reservas futuras.";
    // Usar modal de confirmación
    let confirmar = await new Promise((resolve) => {
      const modal = document.getElementById("actionModal");
      const modalTitle = document.getElementById("actionModalTitle");
      const modalMessage = document.getElementById("actionModalMessage");
      const motivoGroup = document.getElementById("motivoGroup");
      const confirmarBtn = document.getElementById("confirmarAccion");
      const modalAlert = document.getElementById("actionModalAlert");
      if (modalTitle)
        modalTitle.textContent = nuevoEstado
          ? "Activar Espacio"
          : "Desactivar Espacio";
      if (modalMessage) modalMessage.innerHTML = confirmMsg;
      if (motivoGroup) motivoGroup.style.display = "none";
      if (modalAlert) modalAlert.innerHTML = "";
      if (confirmarBtn) {
        confirmarBtn.style.display = "";
        confirmarBtn.className = nuevoEstado
          ? "btn btn-success"
          : "btn btn-danger";
        confirmarBtn.textContent = "Confirmar";
        confirmarBtn.onclick = function () {
          if (modal) modal.classList.remove("active");
          confirmarBtn.onclick = null;
          resolve(true);
        };
      }
      // Cancelar/cerrar
      const cancelarBtn = modal.querySelector(".btn.btn-secondary");
      if (cancelarBtn) {
        cancelarBtn.textContent = "Cancelar";
        cancelarBtn.onclick = function () {
          if (modal) modal.classList.remove("active");
          if (confirmarBtn) confirmarBtn.onclick = null;
          cancelarBtn.onclick = null;
          resolve(false);
        };
      }
      if (modal) modal.classList.add("active");
    });
    if (!confirmar) return;

    const token = localStorage.getItem("token");
    try {
      const response = await fetch("/api/espacios", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json",
          Authorization: `Bearer ${token}`,
        },
        body: JSON.stringify({ id, activo: nuevoEstado }),
      });
      const data = await response.json();
      if (data.success) {
        mostrarModalInfo(
          "¡Éxito!",
          nuevoEstado
            ? "Espacio activado correctamente."
            : `Espacio desactivado.<br>Reservas canceladas: <b>${data.reservasCanceladas || 0}</b>`,
          "success",
        );
        cargarTodosEspacios();
        cargarEspacios(); // Actualizar filtro de reservas
      } else {
        mostrarModalInfo(
          "Error",
          data.error || "Error al actualizar el espacio",
          "error",
        );
      }
    } catch (error) {
      mostrarModalInfo("Error", "Error de conexión", "error");
    }
  };

  // Manejar envío del formulario de espacio
  const espacioForm = document.getElementById("espacioForm");
  if (espacioForm) {
    espacioForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      const alertDiv = document.getElementById("espacioAlert");
      const submitBtn = document.getElementById("espacioSubmitBtn");

      if (alertDiv) alertDiv.innerHTML = "";

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = espacioEditando ? "Guardando..." : "Creando...";
      }

      try {
        const formData = {
          nombre: document.getElementById("espacioNombre")?.value,
          tipo: document.getElementById("espacioTipo")?.value,
          capacidad: document.getElementById("espacioCapacidad")?.value,
          precioHora: document.getElementById("espacioPrecioHora")?.value,
          descripcion:
            document.getElementById("espacioDescripcion")?.value || null,
          techado: document.getElementById("espacioTechado")?.checked || false,
          iluminacion:
            document.getElementById("espacioIluminacion")?.checked || false,
          vestuarios:
            document.getElementById("espacioVestuarios")?.checked || false,
          estacionamiento:
            document.getElementById("espacioEstacionamiento")?.checked || false,
          orden: document.getElementById("espacioOrden")?.value || 0,
        };

        const token = localStorage.getItem("token");
        let response, data;
        if (espacioEditando) {
          // Modo edición
          formData.id = espacioEditando.id;
          response = await fetch("/api/espacios", {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify(formData),
          });
          data = await response.json();
        } else {
          // Modo creación
          response = await fetch("/api/espacios", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify(formData),
          });
          data = await response.json();
        }

        if (data.success) {
          showSuccess(
            espacioEditando ? "Espacio actualizado exitosamente" : "Espacio creado exitosamente",
            "¡Éxito!"
          );
          setTimeout(() => {
            cerrarModalEspacio();
            cargarTodosEspacios();
            cargarEspacios(); // Actualizar filtro de reservas
          }, 1000);
        } else {
          if (alertDiv)
            alertDiv.innerHTML = `<div class="alert alert-error">Error: ${data.error}</div>`;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = espacioEditando ? "Guardar Cambios" : "Crear Espacio";
          }
        }
      } catch (error) {
        console.error("Error:", error);
        if (alertDiv)
          alertDiv.innerHTML = `<div class="alert alert-error">Error de conexión</div>`;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = espacioEditando ? "Guardar Cambios" : "Crear Espacio";
        }
      }
    });
  }

  // Cerrar modal al hacer clic fuera
  const espacioModal = document.getElementById("espacioModal");
  if (espacioModal) {
    espacioModal.addEventListener("click", (e) => {
      if (e.target === espacioModal) {
        cerrarModalEspacio();
      }
    });
  }
</script>
