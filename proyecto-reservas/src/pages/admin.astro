---
// Panel de administrador
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Panel de Administración">
  <Navbar />
  
  <div class="container">
    <h1 class="mb-4">Panel de Administración</h1>
    
    <!-- Tabs de navegación -->
    <div class="mb-4" style="border-bottom: 2px solid var(--border); display: flex; gap: 16px;">
      <button class="tab-btn active" onclick="cambiarTab('reservas')">
        Reservas
      </button>
      <button class="tab-btn" onclick="cambiarTab('bloqueos')">
        Bloqueos de Mantenimiento
      </button>
    </div>
    
    <!-- Tab: Reservas -->
    <div id="tabReservas" class="tab-content active">
    
    <!-- Estadísticas -->
    <div class="grid grid-4 mb-4" id="statsGrid">
      <div class="card stat-card">
        <div class="stat-icon" style="background: #FEF3C7;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div>
          <div style="font-size: 13px; color: var(--text-light); margin-bottom: 4px;">Pendientes</div>
          <div style="font-size: 32px; font-weight: 700; color: var(--dark);" id="statPendientes">-</div>
        </div>
      </div>
      <div class="card stat-card">
        <div class="stat-icon" style="background: #D1FAE5;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div>
          <div style="font-size: 13px; color: var(--text-light); margin-bottom: 4px;">Confirmadas</div>
          <div style="font-size: 32px; font-weight: 700; color: var(--dark);" id="statConfirmadas">-</div>
        </div>
      </div>
      <div class="card stat-card">
        <div class="stat-icon" style="background: #DBEAFE;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#3B82F6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div>
          <div style="font-size: 13px; color: var(--text-light); margin-bottom: 4px;">Hoy</div>
          <div style="font-size: 32px; font-weight: 700; color: var(--dark);" id="statHoy">-</div>
        </div>
      </div>
      <div class="card stat-card">
        <div class="stat-icon" style="background: #E0E7FF;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div>
          <div style="font-size: 13px; color: var(--text-light); margin-bottom: 4px;">Total Mes</div>
          <div style="font-size: 32px; font-weight: 700; color: var(--dark);" id="statTotal">-</div>
        </div>
      </div>
    </div>
    
    <!-- Filtros -->
    <div class="card mb-4">
      <div class="grid grid-4 gap-3">
        <div>
          <label class="form-label">Fecha</label>
          <input type="date" class="form-input" id="fechaFilter">
        </div>
        <div>
          <label class="form-label">Espacio</label>
          <select class="form-select" id="espacioFilter">
            <option value="">Todos los espacios</option>
          </select>
        </div>
        <div>
          <label class="form-label">Estado</label>
          <select class="form-select" id="estadoFilter">
            <option value="">Todos los estados</option>
            <option value="pendiente">Pendiente</option>
            <option value="confirmada">Confirmada</option>
            <option value="completada">Completada</option>
            <option value="cancelada">Cancelada</option>
          </select>
        </div>
        <div style="display: flex; align-items: flex-end;">
          <button class="btn btn-secondary btn-block" onclick="limpiarFiltros()">Limpiar</button>
        </div>
      </div>
    </div>
    
    <!-- Tabla de reservas -->
    <div class="card">
      <div class="flex-between mb-3">
        <h2 class="card-title">Todas las Reservas</h2>
        <div id="conteoReservas" style="color: var(--text-light);"></div>
      </div>
      
      <div id="loading" class="text-center" style="padding: 40px;">
        <div class="loading" style="width: 40px; height: 40px;"></div>
        <p class="mt-2">Cargando reservas...</p>
      </div>
      
      <div id="reservasTable" style="display: none;">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Usuario</th>
                <th>Espacio</th>
                <th>Fecha</th>
                <th>Horario</th>
                <th>Estado</th>
                <th>Monto</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="reservasBody">
            </tbody>
          </table>
        </div>
      </div>
      
      <div id="noReservas" style="display: none; text-align: center; padding: 40px; color: var(--text-light);">
        No hay reservas que coincidan con los filtros
      </div>
    </div>
    <!-- Fin Tab: Reservas -->
    
    <!-- Tab: Bloqueos -->
    <div id="tabBloqueos" class="tab-content" style="display: none;">
      
      <!-- Botón crear bloqueo -->
      <div class="mb-4">
        <button class="btn btn-primary" onclick="abrirModalBloqueo()">
          + Nuevo Bloqueo de Mantenimiento
        </button>
      </div>
      
      <!-- Filtros de bloqueos -->
      <div class="card mb-4">
        <div class="grid grid-3 gap-3">
          <div>
            <label class="form-label">Espacio</label>
            <select class="form-select" id="bloqueoEspacioFilter">
              <option value="">Todos los espacios</option>
            </select>
          </div>
          <div>
            <label class="form-label">Estado</label>
            <select class="form-select" id="bloqueoActivoFilter">
              <option value="">Todos</option>
              <option value="true">Activos</option>
              <option value="false">Inactivos</option>
            </select>
          </div>
          <div style="display: flex; align-items: flex-end;">
            <button class="btn btn-secondary" onclick="limpiarFiltrosBloqueos()">Limpiar</button>
          </div>
        </div>
      </div>
      
      <!-- Lista de bloqueos -->
      <div id="loadingBloqueos" class="text-center" style="padding: 40px;">
        <div class="loading" style="width: 40px; height: 40px;"></div>
        <p class="mt-2">Cargando bloqueos...</p>
      </div>
      
      <div id="bloqueosTable" style="display: none;">
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Espacio</th>
                <th>Fecha Inicio</th>
                <th>Fecha Fin</th>
                <th>Horario</th>
                <th>Motivo</th>
                <th>Estado</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="bloqueosBody">
            </tbody>
          </table>
        </div>
      </div>
      
      <div id="noBloqueos" style="display: none; text-align: center; padding: 40px; color: var(--text-light);">
        No hay bloqueos registrados
      </div>
      
    </div>
    <!-- Fin Tab: Bloqueos -->
    </div>
  </div>
  
  <!-- Modal de confirmación -->
  <div id="actionModal" class="modal">
    <div class="modal-content">
      <h3 style="margin-bottom: 16px;" id="modalTitle"></h3>
      <div id="modalAlert"></div>
      <p id="modalMessage" style="margin-bottom: 16px;"></p>
      <div class="form-group" id="motivoGroup" style="display: none;">
        <label class="form-label">Motivo</label>
        <textarea class="form-textarea" id="motivoInput"></textarea>
      </div>
      <div class="flex gap-2" style="justify-content: flex-end;">
        <button class="btn btn-secondary" onclick="cerrarModal()">Cancelar</button>
        <button class="btn btn-primary" id="confirmarAccion">Confirmar</button>
      </div>
    </div>
  </div>
  
  <!-- Modal de bloqueo -->
  <div id="bloqueoModal" class="modal">
    <div class="modal-content" style="max-width: 600px;">
      <h3 style="margin-bottom: 16px;">Nuevo Bloqueo de Mantenimiento</h3>
      <div id="bloqueoAlert"></div>
      
      <form id="bloqueoForm">
        <div class="form-group">
          <label class="form-label">Espacio *</label>
          <select class="form-select" id="bloqueoEspacio" required>
            <option value="">Seleccione un espacio</option>
          </select>
        </div>
        
        <div class="grid grid-2 gap-3">
          <div class="form-group">
            <label class="form-label">Fecha Inicio *</label>
            <input type="date" class="form-input" id="bloqueoFechaInicio" required>
          </div>
          <div class="form-group">
            <label class="form-label">Fecha Fin *</label>
            <input type="date" class="form-input" id="bloqueoFechaFin" required>
          </div>
        </div>
        
        <div class="form-group">
          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
            <input type="checkbox" id="bloqueoTodoElDia">
            <span>Bloquear todo el día</span>
          </label>
        </div>
        
        <div class="grid grid-2 gap-3" id="horariosGroup">
          <div class="form-group">
            <label class="form-label">Hora Inicio *</label>
            <input type="time" class="form-input" id="bloqueoHoraInicio" required>
          </div>
          <div class="form-group">
            <label class="form-label">Hora Fin *</label>
            <input type="time" class="form-input" id="bloqueoHoraFin" required>
          </div>
        </div>
        
        <div class="form-group">
          <label class="form-label">Motivo *</label>
          <input type="text" class="form-input" id="bloqueoMotivo" placeholder="Ej: Mantenimiento de pasto" required>
        </div>
        
        <div class="form-group">
          <label class="form-label">Descripción (opcional)</label>
          <textarea class="form-textarea" id="bloqueoDescripcion" rows="3"></textarea>
        </div>
        
        <div class="flex gap-2" style="justify-content: flex-end;">
          <button type="button" class="btn btn-secondary" onclick="cerrarModalBloqueo()">Cancelar</button>
          <button type="submit" class="btn btn-primary">Crear Bloqueo</button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<style>
.stat-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px;
}

.stat-icon {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.modal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  align-items: center;
  justify-content: center;
}
.modal.active {
  display: flex;
}
.modal-content {
  background: white;
  padding: 24px;
  border-radius: var(--radius);
  max-width: 500px;
  width: 90%;
  max-height: 90vh;
  overflow-y: auto;
}
</style>

<script>
  // @ts-nocheck
  let todasReservas = [];
  let reservasFiltradas = [];
  let espacios = [];
  let accionActual = null;
  
  async function verificarAdmin() {
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    
    if (!user.id) {
      window.location.href = '/login';
      return false;
    }
    
    if (user.rol !== 'admin') {
      showError('No tienes permisos de administrador', 'Acceso Denegado', '🚫');
      setTimeout(() => {
        window.location.href = '/espacios';
      }, 2000);
      return false;
    }
    
    return true;
  }
  
  async function cargarEspacios() {
    try {
      const response = await fetch('/api/espacios');
      const data = await response.json();
      
      if (data.success) {
        espacios = data.data;
        const select = document.getElementById('espacioFilter');
        if (select) {
          select.innerHTML = '<option value="">Todos los espacios</option>' +
            espacios.map(e => `<option value="${e.id}">${e.nombre}</option>`).join('');
        }
      }
    } catch (error) {
      console.error('Error al cargar espacios:', error);
    }
  }
  
  async function cargarReservas() {
    if (!await verificarAdmin()) return;
    
    const loading = document.getElementById('loading');
    const table = document.getElementById('reservasTable');
    
    try {
      const token = localStorage.getItem('token');
      const response = await fetch('/api/reservas', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      const data = await response.json();
      
      if (loading) loading.style.display = 'none';
      
      if (data.success) {
        todasReservas = data.data;
        
        // Marcar automáticamente como completadas las reservas pasadas
        await marcarReservasPasadasComoCompletadas();
        
        reservasFiltradas = todasReservas;
        if (table) table.style.display = 'block';
        mostrarReservas();
        actualizarEstadisticas();
      }
    } catch (error) {
      if (loading) loading.innerHTML = '<div class="alert alert-error">Error al cargar reservas</div>';
    }
  }
  
  async function marcarReservasPasadasComoCompletadas() {
    const ahora = new Date();
    const token = localStorage.getItem('token');
    
    for (const reserva of todasReservas) {
      // Solo procesar reservas confirmadas
      if (reserva.estado !== 'confirmada') continue;
      
      // Parsear fecha y hora
      const fechaReserva = new Date(reserva.fecha);
      const [horaFin, minutoFin] = reserva.horaFin.split(':').map(Number);
      
      // Crear fecha/hora completa de fin de reserva
      const fechaHoraFin = new Date(fechaReserva);
      fechaHoraFin.setHours(horaFin, minutoFin, 0, 0);
      
      // Si ya pasó la hora de fin, marcar como completada
      if (fechaHoraFin < ahora) {
        try {
          const response = await fetch(`/api/reservas/${reserva.id}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ estado: 'completada' })
          });
          
          if (response.ok) {
            reserva.estado = 'completada';
          }
        } catch (error) {
          console.error(`Error al actualizar reserva ${reserva.id}:`, error);
        }
      }
    }
  }
  
  function actualizarEstadisticas() {
    const hoy = new Date().toISOString().split('T')[0];
    const mesActual = new Date().getMonth();
    const añoActual = new Date().getFullYear();
    
    const statPendientes = document.getElementById('statPendientes');
    const statConfirmadas = document.getElementById('statConfirmadas');
    const statHoy = document.getElementById('statHoy');
    const statTotal = document.getElementById('statTotal');
    
    if (statPendientes) {
      statPendientes.textContent = todasReservas.filter(r => r.estado === 'pendiente').length.toString();
    }
    
    if (statConfirmadas) {
      statConfirmadas.textContent = todasReservas.filter(r => r.estado === 'confirmada').length.toString();
    }
    
    if (statHoy) {
      statHoy.textContent = todasReservas.filter(r => r.fecha === hoy).length.toString();
    }
    
    if (statTotal) {
      statTotal.textContent = todasReservas.filter(r => {
        const fecha = new Date(r.fecha);
        return fecha.getMonth() === mesActual && fecha.getFullYear() === añoActual;
      }).length.toString();
    }
  }
  
  function aplicarFiltros() {
    const fechaFilter = document.getElementById('fechaFilter');
    const espacioFilter = document.getElementById('espacioFilter');
    const estadoFilter = document.getElementById('estadoFilter');
    
    const fecha = fechaFilter?.value || '';
    const espacioId = espacioFilter?.value || '';
    const estado = estadoFilter?.value || '';
    
    reservasFiltradas = todasReservas.filter(r => {
      if (fecha && r.fecha !== fecha) return false;
      if (espacioId && r.espacioId !== parseInt(espacioId)) return false;
      if (estado && r.estado !== estado) return false;
      return true;
    });
    
    mostrarReservas();
  }
  
  function mostrarReservas() {
    const tbody = document.getElementById('reservasBody');
    const noReservas = document.getElementById('noReservas');
    const table = document.getElementById('reservasTable');
    const conteo = document.getElementById('conteoReservas');
    
    if (conteo) {
      conteo.textContent = `Mostrando ${reservasFiltradas.length} de ${todasReservas.length} reservas`;
    }
    
    if (reservasFiltradas.length === 0) {
      if (table) table.style.display = 'none';
      if (noReservas) noReservas.style.display = 'block';
      return;
    }
    
    if (table) table.style.display = 'block';
    if (noReservas) noReservas.style.display = 'none';
    
    if (tbody) {
      tbody.innerHTML = reservasFiltradas.map(r => {
        // Verificar si la reserva ya pasó
        const fechaReserva = new Date(r.fecha);
        const [horaFin, minutoFin] = r.horaFin.split(':').map(Number);
        const fechaHoraFin = new Date(fechaReserva);
        fechaHoraFin.setHours(horaFin, minutoFin, 0, 0);
        const yaPaso = fechaHoraFin < new Date();
        
        return `
      <tr>
        <td>#${r.id}</td>
        <td>
          <div>${r.usuario.nombre} ${r.usuario.apellido || ''}</div>
          <div style="font-size: 12px; color: var(--text-light);">${r.usuario.email}</div>
        </td>
        <td>${r.espacio.nombre}</td>
        <td>${formatFecha(r.fecha)}</td>
        <td>${r.horaInicio} - ${r.horaFin}</td>
        <td><span class="badge badge-${getBadgeColor(r.estado)}">${r.estado.toUpperCase()}</span></td>
        <td>S/ ${r.montoPagado || 0}</td>
        <td>
          <div class="flex gap-1" style="flex-wrap: wrap;">
            ${r.estado === 'pendiente' ? 
              `<button class="btn btn-sm btn-success" onclick="cambiarEstado(${r.id}, 'confirmada')">Confirmar</button>` : ''}
            ${r.estado === 'confirmada' && yaPaso ? 
              `<button class="btn btn-sm btn-info" onclick="cambiarEstado(${r.id}, 'completada')">Completar</button>` : ''}
            ${r.estado !== 'cancelada' && r.estado !== 'completada' ? 
              `<button class="btn btn-sm btn-danger" onclick="abrirModalCancelar(${r.id})">Cancelar</button>` : ''}
          </div>
        </td>
      </tr>
    `;
      }).join('');
    }
  }
  
  function formatFecha(fecha) {
    // Si la fecha ya es un objeto Date válido
    let fechaObj = fecha;
    
    // Si la fecha viene como string (ISO o YYYY-MM-DD)
    if (typeof fecha === 'string') {
      // Intentar formato YYYY-MM-DD
      if (fecha.includes('-') && !fecha.includes('T')) {
        fechaObj = new Date(fecha + 'T00:00:00');
      } else {
        fechaObj = new Date(fecha);
      }
    }
    
    // Verificar que sea válida
    if (isNaN(fechaObj.getTime())) {
      return 'Fecha inválida';
    }
    
    return fechaObj.toLocaleDateString('es-ES', { 
      day: '2-digit', 
      month: '2-digit', 
      year: 'numeric' 
    });
  }
  
  function getBadgeColor(estado) {
    const colors = {
      'pendiente': 'warning',
      'confirmada': 'success',
      'completada': 'info',
      'cancelada': 'secondary'
    };
    return colors[estado] || 'secondary';
  }
  
  window.cambiarEstado = (id, nuevoEstado) => {
    accionActual = { id, tipo: 'cambiarEstado', estado: nuevoEstado };
    
    const modalTitle = document.getElementById('modalTitle');
    const modalMessage = document.getElementById('modalMessage');
    const motivoGroup = document.getElementById('motivoGroup');
    const confirmarBtn = document.getElementById('confirmarAccion');
    const modalAlert = document.getElementById('modalAlert');
    const modal = document.getElementById('actionModal');
    
    if (modalTitle) modalTitle.textContent = 'Cambiar Estado';
    if (modalMessage) modalMessage.textContent = `¿Confirmar cambio de estado a ${nuevoEstado.toUpperCase()}?`;
    if (motivoGroup) motivoGroup.style.display = 'none';
    if (confirmarBtn) confirmarBtn.className = 'btn btn-primary';
    if (modalAlert) modalAlert.innerHTML = '';
    if (modal) modal.classList.add('active');
  };
  
  window.abrirModalCancelar = (id) => {
    accionActual = { id, tipo: 'cancelar' };
    
    const modalTitle = document.getElementById('modalTitle');
    const modalMessage = document.getElementById('modalMessage');
    const motivoGroup = document.getElementById('motivoGroup');
    const motivoInput = document.getElementById('motivoInput');
    const confirmarBtn = document.getElementById('confirmarAccion');
    const modalAlert = document.getElementById('modalAlert');
    const modal = document.getElementById('actionModal');
    
    if (modalTitle) modalTitle.textContent = 'Cancelar Reserva';
    if (modalMessage) modalMessage.textContent = '¿Estás seguro de cancelar esta reserva?';
    if (motivoGroup) motivoGroup.style.display = 'block';
    if (motivoInput) motivoInput.value = '';
    if (confirmarBtn) confirmarBtn.className = 'btn btn-danger';
    if (modalAlert) modalAlert.innerHTML = '';
    if (modal) modal.classList.add('active');
  };
  
  window.cerrarModal = () => {
    const modal = document.getElementById('actionModal');
    if (modal) modal.classList.remove('active');
    accionActual = null;
  };
  
  const btnConfirmar = document.getElementById('confirmarAccion');
  if (btnConfirmar) {
    btnConfirmar.addEventListener('click', async () => {
      if (!accionActual) return;
      
      const btn = document.getElementById('confirmarAccion');
      const alertDiv = document.getElementById('modalAlert');
      
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Procesando...';
      }
      if (alertDiv) alertDiv.innerHTML = '';
      
      try {
        const token = localStorage.getItem('token');
        const user = JSON.parse(localStorage.getItem('user') || '{}');
        
        let response;
        if (accionActual.tipo === 'cambiarEstado') {
          response = await fetch(`/api/reservas/${accionActual.id}`, {
            method: 'PATCH',
            headers: { 
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ estado: accionActual.estado }),
          });
        } else if (accionActual.tipo === 'cancelar') {
          response = await fetch(`/api/reservas/${accionActual.id}`, {
            method: 'DELETE',
            headers: { 
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify({ 
              motivoCancelacion: document.getElementById('motivoInput')?.value || null,
              canceladoPor: user.id
            }),
          });
        }
        
        const data = await response.json();
        
        if (data.success) {
          if (alertDiv) alertDiv.innerHTML = '<div class="alert alert-success">Operación exitosa</div>';
          setTimeout(() => {
            cerrarModal();
            cargarReservas();
          }, 1000);
        } else {
          if (alertDiv) alertDiv.innerHTML = `<div class="alert alert-error">${data.error}</div>`;
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Confirmar';
          }
        }
      } catch (error) {
        if (alertDiv) alertDiv.innerHTML = '<div class="alert alert-error">Error al procesar operación</div>';
        if (btn) {
          btn.disabled = false;
          btn.textContent = 'Confirmar';
        }
      }
    });
  }
  
  window.limpiarFiltros = () => {
    const fechaFilter = document.getElementById('fechaFilter');
    const espacioFilter = document.getElementById('espacioFilter');
    const estadoFilter = document.getElementById('estadoFilter');
    
    if (fechaFilter) fechaFilter.value = '';
    if (espacioFilter) espacioFilter.value = '';
    if (estadoFilter) estadoFilter.value = '';
    
    reservasFiltradas = todasReservas;
    mostrarReservas();
  };
  
  const fechaFilter = document.getElementById('fechaFilter');
  const espacioFilter = document.getElementById('espacioFilter');
  const estadoFilter = document.getElementById('estadoFilter');
  
  if (fechaFilter) fechaFilter.addEventListener('change', aplicarFiltros);
  if (espacioFilter) espacioFilter.addEventListener('change', aplicarFiltros);
  if (estadoFilter) estadoFilter.addEventListener('change', aplicarFiltros);
  
  cargarEspacios();
  cargarReservas();
  
  // ============================================
  // FUNCIONES DE TABS
  // ============================================
  
  window.cambiarTab = (tab) => {
    // Actualizar botones
    const tabBtns = document.querySelectorAll('.tab-btn');
    tabBtns.forEach(btn => btn.classList.remove('active'));
    event.target.classList.add('active');
    
    // Actualizar contenido
    document.getElementById('tabReservas').style.display = tab === 'reservas' ? 'block' : 'none';
    document.getElementById('tabBloqueos').style.display = tab === 'bloqueos' ? 'block' : 'none';
    
    if (tab === 'bloqueos') {
      cargarEspaciosBloqueo();
      cargarBloqueos();
    }
  };
  
  // ============================================
  // FUNCIONES DE BLOQUEOS
  // ============================================
  
  let todosBloqueos = [];
  let bloqueosFiltrados = [];
  
  async function cargarBloqueos() {
    const loadingEl = document.getElementById('loadingBloqueos');
    const tableEl = document.getElementById('bloqueosTable');
    const noDataEl = document.getElementById('noBloqueos');
    
    if (loadingEl) loadingEl.style.display = 'block';
    if (tableEl) tableEl.style.display = 'none';
    if (noDataEl) noDataEl.style.display = 'none';
    
    try {
      const token = localStorage.getItem('token');
      const espacioFilter = document.getElementById('bloqueoEspacioFilter')?.value || '';
      const activoFilter = document.getElementById('bloqueoActivoFilter')?.value || '';
      
      let url = '/api/bloqueos';
      const params = [];
      if (espacioFilter) params.push(`espacioId=${espacioFilter}`);
      if (activoFilter) params.push(`activo=${activoFilter}`);
      if (params.length > 0) url += '?' + params.join('&');
      
      const response = await fetch(url, {
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });
      
      const data = await response.json();
      
      if (data.success) {
        todosBloqueos = data.data;
        bloqueosFiltrados = todosBloqueos;
        mostrarBloqueos();
      }
    } catch (error) {
      console.error('Error al cargar bloqueos:', error);
      if (noDataEl) {
        noDataEl.textContent = 'Error al cargar bloqueos';
        noDataEl.style.display = 'block';
      }
    } finally {
      if (loadingEl) loadingEl.style.display = 'none';
    }
  }
  
  function mostrarBloqueos() {
    const tableEl = document.getElementById('bloqueosTable');
    const bodyEl = document.getElementById('bloqueosBody');
    const noDataEl = document.getElementById('noBloqueos');
    
    if (!bodyEl) return;
    
    if (bloqueosFiltrados.length === 0) {
      if (tableEl) tableEl.style.display = 'none';
      if (noDataEl) noDataEl.style.display = 'block';
      return;
    }
    
    if (tableEl) tableEl.style.display = 'block';
    if (noDataEl) noDataEl.style.display = 'none';
    
    bodyEl.innerHTML = bloqueosFiltrados.map(b => {
      const fechaInicio = new Date(b.fechaInicio).toLocaleDateString('es-ES');
      const fechaFin = new Date(b.fechaFin).toLocaleDateString('es-ES');
      const horario = b.todoElDia ? 'Todo el día' : `${b.horaInicio} - ${b.horaFin}`;
      const estadoBadge = b.activo 
        ? '<span class="badge badge-success">Activo</span>'
        : '<span class="badge badge-secondary">Inactivo</span>';
      
      return `
        <tr>
          <td>${b.id}</td>
          <td><strong>${b.espacio.nombre}</strong><br><small>${b.espacio.tipo}</small></td>
          <td>${fechaInicio}</td>
          <td>${fechaFin}</td>
          <td>${horario}</td>
          <td>${b.motivo}</td>
          <td>${estadoBadge}</td>
          <td>
            ${b.activo ? `<button class="btn btn-sm btn-danger" onclick="desactivarBloqueo(${b.id})">Desactivar</button>` : ''}
          </td>
        </tr>
      `;
    }).join('');
  }
  
  window.desactivarBloqueo = async (id) => {
    const confirmed = await showConfirm(
      '¿Deseas desactivar este bloqueo? Los horarios volverán a estar disponibles.',
      'Confirmar Desactivación',
      '⚠️'
    );
    
    if (!confirmed) return;
    
    try {
      const token = localStorage.getItem('token');
      const response = await fetch(`/api/bloqueos/${id}`, {
        method: 'DELETE',
        headers: {
          'Authorization': `Bearer ${token}`
        }
      });
      
      const data = await response.json();
      
      if (data.success) {
        showSuccess('Bloqueo desactivado correctamente', '¡Listo!', '✅');
        cargarBloqueos();
      } else {
        showError('Error: ' + data.error, 'Error', '❌');
      }
    } catch (error) {
      console.error('Error:', error);
      showError('Error al desactivar bloqueo', 'Error de Conexión', '❌');
    }
  };
  
  window.limpiarFiltrosBloqueos = () => {
    const espacioFilter = document.getElementById('bloqueoEspacioFilter');
    const activoFilter = document.getElementById('bloqueoActivoFilter');
    
    if (espacioFilter) espacioFilter.value = '';
    if (activoFilter) activoFilter.value = '';
    
    cargarBloqueos();
  };
  
  // Event listeners para filtros de bloqueos
  const bloqueoEspacioFilter = document.getElementById('bloqueoEspacioFilter');
  const bloqueoActivoFilter = document.getElementById('bloqueoActivoFilter');
  
  if (bloqueoEspacioFilter) bloqueoEspacioFilter.addEventListener('change', cargarBloqueos);
  if (bloqueoActivoFilter) bloqueoActivoFilter.addEventListener('change', cargarBloqueos);
  
  // ============================================
  // MODAL DE BLOQUEO
  // ============================================
  
  async function cargarEspaciosBloqueo() {
    try {
      const response = await fetch('/api/espacios');
      const data = await response.json();
      
      if (data.success) {
        const selectEspacio = document.getElementById('bloqueoEspacio');
        const selectFilter = document.getElementById('bloqueoEspacioFilter');
        
        if (selectEspacio) {
          selectEspacio.innerHTML = '<option value="">Seleccione un espacio</option>' +
            data.data.map(e => `<option value="${e.id}">${e.nombre} (${e.tipo})</option>`).join('');
        }
        
        if (selectFilter) {
          selectFilter.innerHTML = '<option value="">Todos los espacios</option>' +
            data.data.map(e => `<option value="${e.id}">${e.nombre}</option>`).join('');
        }
      }
    } catch (error) {
      console.error('Error al cargar espacios:', error);
    }
  }
  
  window.abrirModalBloqueo = () => {
    const modal = document.getElementById('bloqueoModal');
    if (modal) modal.classList.add('active');
    
    // Resetear formulario
    const form = document.getElementById('bloqueoForm');
    if (form) form.reset();
    
    // Fecha mínima: hoy
    const fechaInicio = document.getElementById('bloqueoFechaInicio');
    const fechaFin = document.getElementById('bloqueoFechaFin');
    const hoy = new Date().toISOString().split('T')[0];
    if (fechaInicio) fechaInicio.min = hoy;
    if (fechaFin) fechaFin.min = hoy;
  };
  
  window.cerrarModalBloqueo = () => {
    const modal = document.getElementById('bloqueoModal');
    if (modal) modal.classList.remove('active');
  };
  
  // Toggle horarios según checkbox
  const todoElDiaCheckbox = document.getElementById('bloqueoTodoElDia');
  const horariosGroup = document.getElementById('horariosGroup');
  
  if (todoElDiaCheckbox) {
    todoElDiaCheckbox.addEventListener('change', (e) => {
      if (horariosGroup) {
        horariosGroup.style.display = e.target.checked ? 'none' : 'grid';
      }
      
      const horaInicio = document.getElementById('bloqueoHoraInicio');
      const horaFin = document.getElementById('bloqueoHoraFin');
      
      if (e.target.checked) {
        if (horaInicio) horaInicio.removeAttribute('required');
        if (horaFin) horaFin.removeAttribute('required');
      } else {
        if (horaInicio) horaInicio.setAttribute('required', 'required');
        if (horaFin) horaFin.setAttribute('required', 'required');
      }
    });
  }
  
  // Formulario de bloqueo
  const bloqueoForm = document.getElementById('bloqueoForm');
  if (bloqueoForm) {
    bloqueoForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const alertDiv = document.getElementById('bloqueoAlert');
      const submitBtn = e.target.querySelector('button[type="submit"]');
      
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creando...';
      }
      
      try {
        const espacioId = document.getElementById('bloqueoEspacio')?.value;
        const fechaInicio = document.getElementById('bloqueoFechaInicio')?.value;
        const fechaFin = document.getElementById('bloqueoFechaFin')?.value;
        const todoElDia = document.getElementById('bloqueoTodoElDia')?.checked;
        const horaInicio = document.getElementById('bloqueoHoraInicio')?.value;
        const horaFin = document.getElementById('bloqueoHoraFin')?.value;
        const motivo = document.getElementById('bloqueoMotivo')?.value;
        const descripcion = document.getElementById('bloqueoDescripcion')?.value;
        
        const token = localStorage.getItem('token');
        const response = await fetch('/api/bloqueos', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify({
            espacioId: parseInt(espacioId),
            fechaInicio,
            fechaFin,
            horaInicio: todoElDia ? null : horaInicio,
            horaFin: todoElDia ? null : horaFin,
            todoElDia,
            motivo,
            descripcion: descripcion || null
          })
        });
        
        const data = await response.json();
        
        if (data.success) {
          if (alertDiv) alertDiv.innerHTML = '<div class="alert alert-success">Bloqueo creado exitosamente</div>';
          setTimeout(() => {
            cerrarModalBloqueo();
            cargarBloqueos();
          }, 1000);
        } else {
          if (alertDiv) alertDiv.innerHTML = `<div class="alert alert-error">${data.error}</div>`;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Crear Bloqueo';
          }
        }
      } catch (error) {
        console.error('Error:', error);
        if (alertDiv) alertDiv.innerHTML = '<div class="alert alert-error">Error al crear bloqueo</div>';
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Crear Bloqueo';
        }
      }
    });
  }

</script>
