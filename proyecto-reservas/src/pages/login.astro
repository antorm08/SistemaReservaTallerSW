---
// Página de login
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="Iniciar Sesión - Sistema de Reservas">
  <Navbar />
  
  <div class="container-narrow" style="margin-top: 60px;">
    <div class="card">
      <h1 class="card-title text-center mb-3">Iniciar Sesión</h1>
      
      <div id="alert"></div>
      
      <form id="loginForm">
        <div class="form-group">
          <label class="form-label" for="email">Email</label>
          <input type="email" class="form-input" id="email" required placeholder="tu@email.com">
        </div>
        
        <div class="form-group">
          <label class="form-label" for="password">Contraseña</label>
          <input type="password" class="form-input" id="password" required placeholder="••••••">
        </div>
        
        <button type="submit" class="btn btn-primary btn-block" id="submitBtn">
          Iniciar Sesión
        </button>
      </form>
      
      <p class="text-center mt-3" style="color: var(--text-light);">
        ¿No tienes cuenta? <a href="/registro" style="color: var(--primary);">Regístrate aquí</a>
      </p>

      <hr style="margin: 24px 0;">
      
      <div class="alert alert-info">
        <strong>Usuario de prueba:</strong><br>
        Email: admin@deportivo.com<br>
        Password: admin123
      </div>
    </div>
  </div>
</Layout>

<script>
  // @ts-nocheck
  const form = document.getElementById('loginForm');
  const alertDiv = document.getElementById('alert');
  const submitBtn = document.getElementById('submitBtn');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const emailInput = document.getElementById('email');
      const passwordInput = document.getElementById('password');
      
      const email = emailInput?.value;
      const password = passwordInput?.value;
      
      if (!email || !password) return;
      
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="loading"></span> Iniciando...';
      }
      if (alertDiv) alertDiv.innerHTML = '';
      
      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        
        const data = await response.json();
        
        if (data.success) {
          localStorage.setItem('token', data.data.token);
          localStorage.setItem('user', JSON.stringify(data.data.usuario));
          
          if (alertDiv) alertDiv.innerHTML = '<div class="alert alert-success">¡Inicio de sesión exitoso! Redirigiendo...</div>';
          
          // Redirigir a la página guardada o a espacios si es usuario normal
          const redirectTo = sessionStorage.getItem('redirectAfterLogin');
          sessionStorage.removeItem('redirectAfterLogin');
          
          setTimeout(() => {
            if (redirectTo) {
              window.location.href = redirectTo;
            } else if (data.data.usuario.rol === 'admin') {
              window.location.href = '/admin';
            } else {
              window.location.href = '/espacios';
            }
          }, 1000);
        } else {
          if (alertDiv) alertDiv.innerHTML = `<div class="alert alert-error">${data.error}</div>`;
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Iniciar Sesión';
          }
        }
      } catch (error) {
        if (alertDiv) alertDiv.innerHTML = '<div class="alert alert-error">Error de conexión. Intenta nuevamente.</div>';
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Iniciar Sesión';
        }
      }
    });
  }
</script>
