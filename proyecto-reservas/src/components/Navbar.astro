---
// Componente de navegación
const currentPath = Astro.url.pathname;
---

<nav class="navbar" aria-label="Navegación principal">
  <div class="container">
    <div class="navbar-content">
      <a href="/" class="navbar-brand">
        <span class="brand-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v16H4z"/><path d="M4 9h16M9 4v16M15 4v16M4 15h16"/><circle cx="12" cy="12" r="2.5"/></svg>
        </span>
        <span class="brand-text">Centro Deportivo</span>
      </a>
      <ul class="navbar-nav" id="navbarMenu">
        <li><a href="/" class={`navbar-link ${currentPath === '/' ? 'active' : ''}`} aria-current={currentPath === '/' ? 'page' : undefined}>Inicio</a></li>
        <li><a href="/espacios" class={`navbar-link ${currentPath === '/espacios' ? 'active' : ''}`} aria-current={currentPath === '/espacios' ? 'page' : undefined}>Espacios</a></li>
        <li><a href="/mis-reservas" class={`navbar-link ${currentPath === '/mis-reservas' ? 'active' : ''}`} aria-current={currentPath === '/mis-reservas' ? 'page' : undefined}>Mis Reservas</a></li>
        <li id="adminMenuItem" style="display: none;"><a href="/admin" class={`navbar-link ${currentPath === '/admin' ? 'active' : ''}`} aria-current={currentPath === '/admin' ? 'page' : undefined}>Admin</a></li>
        <li id="authMenuItem"><a href="/login" class="btn btn-primary navbar-btn" id="authLink">Iniciar Sesión</a></li>
      </ul>
    </div>
  </div>
</nav>

<style>
  .navbar {
    background: rgba(7, 26, 43, 0.97);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(2, 12, 22, 0.18);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0;
    margin-bottom: 0;
    backdrop-filter: blur(16px);
  }
  
  .navbar-content {
    min-height: 72px;
    padding: 10px 0;
  }
  
  .navbar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 19px;
    font-weight: 800;
    color: var(--white);
    text-decoration: none;
    letter-spacing: -0.02em;
  }
  
  .brand-icon {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    color: var(--accent);
    background: rgba(191, 255, 73, 0.1);
    border: 1px solid rgba(191, 255, 73, 0.34);
    border-radius: 12px 4px 12px 4px;
  }
  
  .brand-text {
    color: var(--white);
  }
  
  .navbar-link {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.2s, background-color 0.2s;
    padding: 10px 12px;
    border-radius: 8px;
    font-weight: 650;
  }
  
  .navbar-link:hover {
    color: var(--white);
    background: rgba(255, 255, 255, 0.07);
  }
  
  .navbar-link.active {
    color: var(--accent);
    font-weight: 750;
    position: relative;
  }
  
  .navbar-link.active::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 12px;
    right: 12px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }
  
  .navbar-btn {
    font-size: 13px;
    padding: 10px 18px;
  }

  @media (max-width: 760px) {
    .navbar-content {
      align-items: stretch;
      gap: 8px;
      padding: 10px 0 8px;
    }

    .navbar-brand {
      align-self: flex-start;
    }

    .navbar-nav {
      width: 100%;
      justify-content: flex-start;
      gap: 4px;
      overflow-x: auto;
      padding: 4px 0 2px;
      scrollbar-width: none;
    }

    .navbar-nav::-webkit-scrollbar {
      display: none;
    }

    .navbar-nav li {
      flex: 0 0 auto;
    }

    .navbar-link {
      display: block;
      white-space: nowrap;
      font-size: 13px;
      padding: 9px 10px;
    }

    .navbar-btn {
      white-space: nowrap;
      padding: 9px 14px;
    }
  }
</style>

<script>
  // @ts-nocheck
  // Manejo de autenticación en el cliente
  const token = localStorage.getItem('token');
  const userStr = localStorage.getItem('user');
  const authMenuItem = document.getElementById('authMenuItem');
  const adminMenuItem = document.getElementById('adminMenuItem');
  
  if (token && authMenuItem) {
    // Reemplazar el enlace con un botón para evitar href inválido
    authMenuItem.innerHTML = '<button type="button" class="btn btn-primary navbar-btn" id="logoutBtn">Cerrar Sesión</button>';
    
    const logoutBtn = document.getElementById('logoutBtn');
    if (logoutBtn) {
      logoutBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        await fetch('/api/auth/logout', { method: 'POST' });
        localStorage.removeItem('token');
        localStorage.removeItem('user');
        window.location.href = '/login';
      });
    }
    
    // Mostrar menú Admin solo si el usuario es admin
    if (userStr) {
      try {
        const user = JSON.parse(userStr);
        if (user && user.rol === 'admin' && adminMenuItem) {
          adminMenuItem.style.display = 'block';
        }
      } catch (e) {
        console.error('Error al parsear usuario:', e);
      }
    }
  }
</script>
