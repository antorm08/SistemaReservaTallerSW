# URL pooled de PostgreSQL proporcionada por Neon
DATABASE_URL="postgresql://usuario:contrasena@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret (cambiar en producción)
JWT_SECRET="tu-secreto-super-seguro-cambiar-en-produccion"

# Contraseña inicial del administrador (solo para el seed)
SEED_ADMIN_PASSWORD="reemplazar-por-una-contrasena-segura"

# Puerto y host del servidor (opcionales)
PORT=4321
HOST="0.0.0.0"

# Entorno
NODE_ENV="development"
